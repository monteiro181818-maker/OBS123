            confronto.jogador2.nome,

        time2:
            confronto.jogador2.time,

        foto2:
            confronto.jogador2.foto,

        placar1,
        placar2,

        vencedor:
            escolhido
                ? escolhido.nome
                : null,

        ladoVencedor:
            escolhido
                ? escolhido.lado
                : null,

        timeIdeal,
        modoFinal

    });
}


/* ESCOLHER */

async function escolherJogador(lado) {

    const confronto =
        confrontos[indice];

    if (!confronto) return;

    const numeroPosicao =
        indice + 1;

    const jogador =
        lado === 1
            ? confronto.jogador1
            : confronto.jogador2;

    const anterior =
        buscarEscolhidoDaPosicao(
            numeroPosicao
        );

    if (anterior) {

        if (Number(anterior.lado) === 1) {
            placar1 =
                Math.max(0, placar1 - 1);
        }

        if (Number(anterior.lado) === 2) {
            placar2 =
                Math.max(0, placar2 - 1);
        }

        timeIdeal =
            timeIdeal.filter(
                item =>
                    Number(
                        item.numeroPosicao
                    ) !== numeroPosicao
            );
    }

    if (lado === 1) {
        placar1++;
    } else {
        placar2++;
    }

    const escolhido = {

        numeroPosicao,
        posicao: confronto.posicao,

        nome: jogador.nome,
        time: jogador.time,
        foto: jogador.foto,

        lado
    };

    timeIdeal.push(escolhido);

    timeIdeal.sort(
        (a,b) =>
            Number(a.numeroPosicao) -
            Number(b.numeroPosicao)
    );

    atualizarVencedorPainel(
        escolhido
    );

    await enviarConfrontoAtual();
}


function atualizarVencedorPainel(
    escolhido
) {

    const elemento =
        document.getElementById(
            "vencedor"
        );

    if (!escolhido) {

        elemento.innerText =
            "Nenhum jogador escolhido";

        elemento.classList.remove(
            "escolhido"
        );

        return;
    }

    elemento.innerText =
        "✓ ESCOLHIDO: " +
        escolhido.nome;

    elemento.classList.add(
        "escolhido"
    );
}


/* NAVEGAÇÃO */

function anterior() {

    if (indice <= 0) return;

    indice--;
    modoFinal = false;

    atualizarBotaoFinal();

    carregarConfronto(indice);
}


function proximo() {

    if (
        indice >=
        confrontos.length - 1
    ) return;

    indice++;
    modoFinal = false;

    atualizarBotaoFinal();

    carregarConfronto(indice);
}


