async function enviarConfrontoAtual() {

    const confronto =
        confrontos[indice];

    if (!confronto) return;

    const escolhido =
        buscarEscolhidoDaPosicao(
            indice + 1
        );

    await enviarEstado({

        posicao:
            confronto.posicao,

        numeroPosicao:
            indice + 1,

        jogador1:
            confronto.jogador1.nome,

        time1:
