/* CARREGAR POSIÇÃO */

function carregarConfronto(
    numero,
    enviar=true
) {

    if (!confrontos.length) return;

    indice = Math.max(
        0,
        Math.min(
            numero,
            confrontos.length - 1
        )
    );

    const confronto =
        confrontos[indice];

    document.getElementById(
        "numeroPosicao"
    ).innerText =
        `${indice + 1} / ${confrontos.length}`;

    document.getElementById(
        "posicaoAtual"
    ).innerText =
        confronto.posicao;

    document.getElementById(
        "jogador1"
    ).value =
        confronto.jogador1.nome || "";

    document.getElementById(
        "time1"
    ).value =
        confronto.jogador1.time || "";

    document.getElementById(
        "foto1"
    ).value =
        confronto.jogador1.foto || "";

    document.getElementById(
        "jogador2"
    ).value =
        confronto.jogador2.nome || "";

    document.getElementById(
        "time2"
    ).value =
        confronto.jogador2.time || "";

    document.getElementById(
        "foto2"
    ).value =
        confronto.jogador2.foto || "";

    atualizarVencedorPainel(
        buscarEscolhidoDaPosicao(
            indice + 1
        )
    );

    if (enviar) {
        enviarConfrontoAtual();
    }
}


function buscarEscolhidoDaPosicao(numero) {

    return timeIdeal.find(
        jogador =>
            Number(jogador.numeroPosicao) ===
            Number(numero)
    ) || null;
}


