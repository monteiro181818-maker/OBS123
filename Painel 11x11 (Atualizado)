    const campo =
        document.getElementById(
            "arquivoNovaFoto"
        );

    campo.value = "";
    campo.click();
}


function arquivoParaBase64(arquivo) {

    return new Promise(
        (resolver,rejeitar) => {

            const leitor =
                new FileReader();

            leitor.onload =
                () =>
                    resolver(
                        leitor.result
                    );

            leitor.onerror =
                () =>
                    rejeitar(
                        new Error(
                            "Erro ao ler imagem."
                        )
                    );

            leitor.readAsDataURL(
                arquivo
            );
        }
    );
}


async function enviarNovaFoto(evento) {

    const arquivo =
        evento.target.files[0];

    if (!arquivo) return;

    const limite =
        15 * 1024 * 1024;

    if (arquivo.size > limite) {

        alert(
            "Limite da imagem: 15 MB."
        );

        return;
    }

    const botao =
        document.getElementById(
            "botaoAdicionarFoto"
        );

    try {

        botao.disabled = true;
        botao.innerText =
            "ENVIANDO...";

        const conteudo =
            await arquivoParaBase64(
                arquivo
            );

        const resposta =
            await fetch(
                "/api/upload-imagem",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({
                            nome: arquivo.name,
                            conteudo
                        })
                }
            );

        const resultado =
            await resposta.json();

        if (!resultado.ok) {
            throw new Error(
                resultado.erro
            );
        }

        await carregarImagens();

        if (campoFotoDestino) {

            const campo =
                document.getElementById(
                    campoFotoDestino
                );

            if (campo) {
                campo.value =
                    resultado.arquivo;
            }
        }

        fecharGaleria();

        statusServidor(
            "FOTO ADICIONADA"
        );

    } catch (erro) {

        alert(
            "Erro ao adicionar foto:\n\n" +
            erro.message
        );

    } finally {

        botao.disabled = false;

        botao.innerText =
            "➕ ADICIONAR NOVA FOTO";

        evento.target.value = "";
    }
}


/* ESC */

document.addEventListener(
    "keydown",
    evento => {

        if (evento.key === "Escape") {
            fecharGaleria();
        }
    }
);


/* INICIAR */

carregarConfrontos();
carregarSalvos();

