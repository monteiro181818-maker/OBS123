<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">

<title>Painel 11x11 Metreacts</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 30px;
    background: #090a10;
    color: white;
    font-family: Arial, sans-serif;
}

.painel {
    width: 1000px;
    max-width: 100%;
    margin: auto;
    background: #11131c;
    border: 2px solid #633cff;
    border-radius: 18px;
    padding: 30px;
    box-shadow: 0 0 30px rgba(99,60,255,.30);
}

h1 {
    margin-top: 0;
    text-align: center;
    font-size: 32px;
}

/* MODOS */

.modos {
    display: flex;
    gap: 12px;
    margin-bottom: 30px;
}

.botao-modo {
    flex: 1;
    height: 55px;
    background: #202330;
    color: #c7cad4;
    border: 1px solid #383d4d;
    border-radius: 10px;
    font-size: 17px;
    font-weight: 900;
    cursor: pointer;
}

.botao-modo:hover {
    filter: brightness(1.15);
}

.botao-modo.ativo {
    background: linear-gradient(90deg,#633cff,#8d2ee0);
    color: white;
    border-color: #9b82ff;
    box-shadow: 0 0 15px rgba(99,60,255,.35);
}

#areaOperar {
    display: block;
}

#areaConfigurar {
    display: none;
}

/* OPERAÇÃO */

.posicao {
    margin-top: 25px;
    margin-bottom: 30px;
    text-align: center;
}

.posicao-numero {
    color: #9b82ff;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 8px;
}

#posicaoAtual {
    font-size: 30px;
    font-weight: 900;
}

.comparacao {
    display: flex;
    gap: 25px;
}

.jogador {
    flex: 1;
    background: #181b26;
    border: 1px solid #303443;
    border-radius: 14px;
    padding: 22px;
}

.jogador1 {
    border-top: 4px solid #168cff;
}

.jogador2 {
    border-top: 4px solid #ad24ff;
}

label {
    display: block;
    margin-bottom: 8px;
    color: #aeb3c2;
    font-size: 14px;
    font-weight: bold;
}

input {
    width: 100%;
    height: 46px;
    padding: 0 14px;
    margin-bottom: 15px;
    background: #0d0f16;
    color: white;
    border: 1px solid #363a49;
    border-radius: 8px;
    font-size: 17px;
    outline: none;
}

input:focus {
    border-color: #704cff;
}

.escolher {
    width: 100%;
    height: 50px;
    margin-top: 5px;
    border: none;
    border-radius: 9px;
    color: white;
    font-size: 17px;
    font-weight: 900;
    cursor: pointer;
}

.escolher1 {
    background: #1677d2;
}

.escolher2 {
    background: #8d2ee0;
}

.escolher:hover {
    filter: brightness(1.15);
}

#vencedor {
    margin-top: 25px;
    min-height: 55px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d0f16;
    border-radius: 10px;
    font-size: 19px;
    font-weight: bold;
    color: #b8bdca;
}

#vencedor.escolhido {
    color: white;
    border: 1px solid #633cff;
}

/* NAVEGAÇÃO */

.navegacao {
    margin-top: 25px;
    display: flex;
    gap: 15px;
}

.navegacao button {
    flex: 1;
    height: 52px;
    background: #252938;
    color: white;
    border: 1px solid #3b4052;
    border-radius: 9px;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
}

#proximo {
    background: #633cff;
    border-color: #795cff;
}

/* RESULTADO */

.resultado-area {
    margin-top: 20px;
}

#resultadoFinal {
    width: 100%;
    height: 58px;
    background: linear-gradient(90deg,#633cff,#8d2ee0);
    color: white;
    border: 2px solid #9b82ff;
    border-radius: 10px;
    font-size: 18px;
    font-weight: 900;
    cursor: pointer;
}

#resultadoFinal.ativo {
    background: linear-gradient(90deg,#187a48,#22a964);
    border-color: #42d889;
}

.reset-area {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid #2d3140;
}

#resetar {
    width: 100%;
    height: 52px;
    background: #9e2633;
    color: white;
    border: 1px solid #d23a4a;
    border-radius: 9px;
    font-size: 17px;
    font-weight: 900;
    cursor: pointer;
}

/* CONFIGURAÇÃO */

.config-cabecalho {
    text-align: center;
    margin-bottom: 25px;
}

.config-cabecalho h2 {
    margin: 0 0 8px;
}

.config-cabecalho p {
    color: #969cab;
}

.nome-projeto {
    background: #161923;
    border: 1px solid #303443;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
}

.nome-projeto input {
    margin-bottom: 0;
}

.times-config {
    display: flex;
    gap: 20px;
    margin-bottom: 25px;
    padding: 20px;
    background: #161923;
    border: 1px solid #303443;
    border-radius: 12px;
}

.time-config {
    flex: 1;
}

.lista-config {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.confronto-config {
    background: #161923;
    border: 1px solid #303443;
    border-radius: 14px;
    padding: 20px;
}

.titulo-posicao-config {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
}

.numero-config {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #633cff;
    border-radius: 50%;
    font-weight: 900;
}

.nome-posicao-config {
    flex: 1;
    font-size: 20px;
    font-weight: 900;
}

.jogadores-config {
    display: grid;
    grid-template-columns: 1fr 70px 1fr;
    gap: 15px;
    align-items: center;
}

.lado-config {
    padding: 16px;
    background: #0d0f16;
    border-radius: 10px;
}

.lado-config.azul {
    border-left: 4px solid #168cff;
}

.lado-config.roxo {
    border-right: 4px solid #ad24ff;
}

.vs-config {
    text-align: center;
    font-size: 24px;
    font-weight: 900;
    color: #9b82ff;
}

.config-input {
    margin-bottom: 10px;
}

.config-input:last-child {
    margin-bottom: 0;
}

.config-input input {
    margin-bottom: 0;
    height: 42px;
    font-size: 15px;
}

.foto-linha {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
}

.foto-linha input {
    min-width: 0;
}

.botao-foto {
    height: 42px;
    padding: 0 13px;
    background: #252938;
    color: white;
    border: 1px solid #4b5165;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 900;
    cursor: pointer;
}

/* BOTÕES CONFIG */

.acoes-config {
    margin-top: 30px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
}

#novo11x11 {
    background: #252938;
    border: 2px solid #4b5165;
}

.botao-config-principal {
    height: 60px;
    color: white;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 900;
    cursor: pointer;
}

#salvarConfiguracao {
    background: linear-gradient(90deg,#187a48,#22a964);
    border: 2px solid #42d889;
}

#salvarBiblioteca {
    background: linear-gradient(90deg,#633cff,#8d2ee0);
    border: 2px solid #9b82ff;
}

.botao-config-principal:disabled {
    opacity: .5;
    cursor: wait;
}

/* BIBLIOTECA */

.biblioteca {
    margin-top: 30px;
    padding-top: 25px;
    border-top: 1px solid #303443;
}

.biblioteca h2 {
    margin: 0 0 15px;
}

.lista-salvos {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.salvo {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 10px;
    align-items: center;
    background: #161923;
    border: 1px solid #303443;
    border-radius: 10px;
    padding: 14px;
}

.salvo-nome {
    font-size: 16px;
    font-weight: 900;
}

.salvo-times {
    color: #9298a8;
    font-size: 13px;
    margin-top: 4px;
}

.editar-salvo,
.carregar-salvo,
.excluir-salvo {
    height: 40px;
    padding: 0 14px;
    border-radius: 7px;
    color: white;
    font-weight: 900;
    cursor: pointer;
}

.editar-salvo {
    background: #187a48;
    border: 1px solid #42d889;
}

.carregar-salvo {
    background: #633cff;
    border: 1px solid #8068ff;
}

.excluir-salvo {
    background: #8f2632;
    border: 1px solid #c33a49;
}

.sem-salvos {
    padding: 20px;
    text-align: center;
    color: #9298a8;
    background: #0d0f16;
    border-radius: 10px;
}

/* GALERIA */

.modal-fotos {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(3,4,8,.90);
    padding: 35px;
    align-items: center;
    justify-content: center;
}

.modal-fotos.aberto {
    display: flex;
}

.galeria-box {
    width: 1100px;
    max-width: 95vw;
    max-height: 90vh;
    background: #11131c;
    border: 2px solid #633cff;
    border-radius: 18px;
    padding: 22px;
    display: flex;
    flex-direction: column;
}

.galeria-topo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;
}

.galeria-topo h2 {
    margin: 0;
}

.acoes-galeria {
    display: flex;
    gap: 10px;
}

.adicionar-foto {
    height: 44px;
    padding: 0 18px;
    background: linear-gradient(90deg,#187a48,#22a964);
    color: white;
    border: 1px solid #42d889;
    border-radius: 9px;
    font-weight: 900;
    cursor: pointer;
}

.fechar-galeria {
    width: 44px;
    height: 44px;
    background: #252938;
    color: white;
    border: 1px solid #4a5062;
    border-radius: 9px;
    font-size: 22px;
    cursor: pointer;
}

#buscaFoto {
    margin-bottom: 12px;
}

.galeria-info {
    margin-bottom: 12px;
    color: #aeb3c2;
    font-size: 13px;
}

.grade-fotos {
    overflow-y: auto;
    display: grid;
    grid-template-columns: repeat(5,1fr);
    gap: 12px;
}

.item-foto {
    background: #0d0f16;
    border: 2px solid #2c3140;
    border-radius: 11px;
    padding: 9px;
    cursor: pointer;
}

.item-foto:hover {
    border-color: #795cff;
}

.item-foto.selecionada {
    border-color: #42d889;
}

.item-foto img {
    width: 100%;
    height: 135px;
    object-fit: contain;
    background: #08090d;
    border-radius: 7px;
}

.nome-foto {
    margin-top: 8px;
    text-align: center;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sem-fotos {
    grid-column: 1/-1;
    padding: 35px;
    text-align: center;
    color: #9da3b3;
}

#statusServidor {
    margin-top: 20px;
    text-align: center;
    font-weight: bold;
    color: #6cff9d;
}

</style>

</head>

<body>

<div class="painel">

<h1>PAINEL 11x11</h1>

<div class="modos">

<button
    id="botaoOperar"
    class="botao-modo ativo"
    onclick="mudarModo('operar')">
    🎮 OPERAR 11x11
</button>

<button
    id="botaoConfigurar"
    class="botao-modo"
    onclick="mudarModo('configurar')">
    ⚙️ CONFIGURAR 11x11
</button>

</div>


<!-- OPERAR -->

<div id="areaOperar">

<div class="posicao">
    <div id="numeroPosicao" class="posicao-numero">
        1 / 11
    </div>

    <div id="posicaoAtual">
        CARREGANDO...
    </div>
</div>

<div class="comparacao">

<div class="jogador jogador1">

<label>JOGADOR 1</label>
<input id="jogador1" type="text">

<label>TIME / SELEÇÃO</label>
<input id="time1" type="text">

<label>ARQUIVO DA FOTO</label>
<input id="foto1" type="text">

<button
    class="escolher escolher1"
    onclick="escolherJogador(1)">
    ESCOLHER
</button>

</div>

<div class="jogador jogador2">

<label>JOGADOR 2</label>
<input id="jogador2" type="text">

<label>TIME / SELEÇÃO</label>
<input id="time2" type="text">

<label>ARQUIVO DA FOTO</label>
<input id="foto2" type="text">

<button
    class="escolher escolher2"
    onclick="escolherJogador(2)">
    ESCOLHER
</button>

</div>

</div>

<div id="vencedor">
    Nenhum jogador escolhido
</div>

<div class="navegacao">

<button onclick="anterior()">
    ← ANTERIOR
</button>

<button id="proximo" onclick="proximo()">
    PRÓXIMO →
</button>

</div>

<div class="resultado-area">

<button
    id="resultadoFinal"
    onclick="mostrarResultadoFinal()">
    🏆 MOSTRAR RESULTADO FINAL
</button>

</div>

<div class="reset-area">

<button
    id="resetar"
    onclick="resetar11x11()">
    RESETAR 11x11
</button>

</div>

</div>


<!-- CONFIGURAR -->

<div id="areaConfigurar">

<div class="config-cabecalho">

<h2>CONFIGURAR 11x11</h2>

<p>
Crie, salve e carregue seus confrontos.
</p>

</div>

<div class="nome-projeto">

<label>NOME DO 11x11</label>

<input
    id="nome11x11"
    type="text"
    placeholder="Ex.: Brasil x Argentina">

</div>

<div class="times-config">

<div class="time-config">

<label>TIME / SELEÇÃO 1</label>

<input
    id="configTime1"
    type="text"
    placeholder="Brasil">

</div>

<div class="time-config">

<label>TIME / SELEÇÃO 2</label>

<input
    id="configTime2"
    type="text"
    placeholder="Argentina">

</div>

</div>

<div
    id="listaConfiguracao"
    class="lista-config">
</div>

<div class="acoes-config">

<button
    id="novo11x11"
    class="botao-config-principal"
    onclick="criarNovo11x11()">

    ➕ NOVO 11x11

</button>

<button
    id="salvarConfiguracao"
    class="botao-config-principal"
    onclick="salvarNovo11x11()">

    ▶ SALVAR E CARREGAR

</button>

<button
    id="salvarBiblioteca"
    class="botao-config-principal"
    onclick="salvarNaBiblioteca()">

    💾 SALVAR NA BIBLIOTECA

</button>

</div>


<div class="biblioteca">

<h2>📂 11x11 SALVOS</h2>

<div
    id="listaSalvos"
    class="lista-salvos">

    <div class="sem-salvos">
        Carregando...
    </div>

</div>

</div>

</div>

<div id="statusServidor">
    CARREGANDO...
</div>

</div>


<!-- GALERIA -->

<div
    id="modalFotos"
    class="modal-fotos"
    onclick="fecharGaleriaFora(event)">

<div class="galeria-box">

<div class="galeria-topo">

<h2>📷 ESCOLHER FOTO</h2>

<div class="acoes-galeria">

<button
    id="botaoAdicionarFoto"
    class="adicionar-foto"
    onclick="abrirSeletorNovaFoto()">

    ➕ ADICIONAR NOVA FOTO

</button>

<button
    class="fechar-galeria"
    onclick="fecharGaleria()">

    ✕

</button>

</div>

</div>

<input
    type="file"
    id="arquivoNovaFoto"
    accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
    style="display:none"
    onchange="enviarNovaFoto(event)">

<input
    id="buscaFoto"
    type="text"
    placeholder="🔎 Pesquisar foto..."
    oninput="filtrarFotos()">

<div
    id="galeriaInfo"
    class="galeria-info">
</div>

<div
    id="gradeFotos"
    class="grade-fotos">
</div>

</div>

</div>


<script>

/* VARIÁVEIS */

let confrontos = [];
let indice = 0;

let placar1 = 0;
let placar2 = 0;

let timeIdeal = [];
let modoFinal = false;

let imagensDisponiveis = [];
let campoFotoDestino = null;


/* STATUS */

function statusServidor(texto, cor="#6cff9d") {

    const elemento =
        document.getElementById(
            "statusServidor"
        );

    elemento.innerText = texto;
    elemento.style.color = cor;
}


/* MODOS */

function mudarModo(modo) {

    const operar =
        document.getElementById(
            "areaOperar"
        );

    const configurar =
        document.getElementById(
            "areaConfigurar"
        );

    const botaoOperar =
        document.getElementById(
            "botaoOperar"
        );

    const botaoConfigurar =
        document.getElementById(
            "botaoConfigurar"
        );

    if (modo === "configurar") {

        operar.style.display = "none";
        configurar.style.display = "block";

        botaoOperar.classList.remove("ativo");
        botaoConfigurar.classList.add("ativo");

        montarConfiguracao();
        carregarSalvos();

    } else {

        configurar.style.display = "none";
        operar.style.display = "block";

        botaoConfigurar.classList.remove("ativo");
        botaoOperar.classList.add("ativo");
    }
}


/* ESCAPAR HTML */

function escaparHTML(texto) {

    return String(texto ?? "")
        .replaceAll("&","&amp;")
        .replaceAll('"',"&quot;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;");
}


/* CONFIGURAÇÃO */

function montarConfiguracao() {

    const lista =
        document.getElementById(
            "listaConfiguracao"
        );

    lista.innerHTML = "";

    if (!confrontos.length) {
        lista.innerHTML =
            '<div class="sem-salvos">Nenhum confronto carregado.</div>';
        return;
    }

    document.getElementById(
        "configTime1"
    ).value =
        confrontos[0].jogador1.time || "";

    document.getElementById(
        "configTime2"
    ).value =
        confrontos[0].jogador2.time || "";

    confrontos.forEach(
        (confronto, numero) => {

            const bloco =
                document.createElement("div");

            bloco.className =
                "confronto-config";

            bloco.innerHTML = `

            <div class="titulo-posicao-config">

                <div class="numero-config">
                    ${numero + 1}
                </div>

                <div class="nome-posicao-config">
                    ${escaparHTML(confronto.posicao)}
                </div>

            </div>

            <div class="jogadores-config">

                <div class="lado-config azul">

                    <div class="config-input">

                        <label>JOGADOR 1</label>

                        <input
                            id="configJogador1_${numero}"
                            type="text"
                            value="${escaparHTML(
                                confronto.jogador1.nome
                            )}">

                    </div>

                    <div class="config-input">

                        <label>FOTO</label>

                        <div class="foto-linha">

                            <input
                                id="configFoto1_${numero}"
                                type="text"
                                readonly
                                value="${escaparHTML(
                                    confronto.jogador1.foto
                                )}">

                            <button
                                type="button"
                                class="botao-foto"
                                onclick="abrirGaleria(
                                    'configFoto1_${numero}'
                                )">

                                📷 ESCOLHER

                            </button>

                        </div>

                    </div>

                </div>

                <div class="vs-config">
                    VS
                </div>

                <div class="lado-config roxo">

                    <div class="config-input">

                        <label>JOGADOR 2</label>

                        <input
                            id="configJogador2_${numero}"
                            type="text"
                            value="${escaparHTML(
                                confronto.jogador2.nome
                            )}">

                    </div>

                    <div class="config-input">

                        <label>FOTO</label>

                        <div class="foto-linha">

                            <input
                                id="configFoto2_${numero}"
                                type="text"
                                readonly
                                value="${escaparHTML(
                                    confronto.jogador2.foto
                                )}">

                            <button
                                type="button"
                                class="botao-foto"
                                onclick="abrirGaleria(
                                    'configFoto2_${numero}'
                                )">

                                📷 ESCOLHER

                            </button>

                        </div>

                    </div>

                </div>

            </div>
            `;

            lista.appendChild(bloco);
        }
    );
}


/* PEGAR CONFIGURAÇÃO */

function pegarConfiguracao() {

    if (confrontos.length !== 11) {
        throw new Error(
            "O 11x11 precisa ter 11 posições."
        );
    }

    const time1 =
        document.getElementById(
            "configTime1"
        ).value.trim();

    const time2 =
        document.getElementById(
            "configTime2"
        ).value.trim();

    if (!time1 || !time2) {
        throw new Error(
            "Preencha os dois times/seleções."
        );
    }

    const novos = [];

    for (
        let numero = 0;
        numero < confrontos.length;
        numero++
    ) {

        const jogador1 =
            document.getElementById(
                "configJogador1_" + numero
            ).value.trim();

        const jogador2 =
            document.getElementById(
