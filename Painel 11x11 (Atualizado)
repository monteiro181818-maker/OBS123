async function abrirGaleria(campo) {

    campoFotoDestino = campo;

    await carregarImagens();

    document.getElementById(
        "buscaFoto"
    ).value = "";

    document.getElementById(
        "modalFotos"
    ).classList.add("aberto");

    renderizarFotos(
        imagensDisponiveis
    );
}


function fecharGaleria() {

    document.getElementById(
        "modalFotos"
    ).classList.remove("aberto");

    campoFotoDestino = null;
}


function fecharGaleriaFora(evento) {

    if (
        evento.target.id ===
        "modalFotos"
    ) {
        fecharGaleria();
    }
}


function filtrarFotos() {

    const busca =
        document.getElementById(
            "buscaFoto"
        ).value.toLowerCase();

    const filtradas =
        imagensDisponiveis.filter(
            nome =>
                nome.toLowerCase()
                    .includes(busca)
        );

    renderizarFotos(filtradas);
}


function renderizarFotos(lista) {

    const grade =
        document.getElementById(
            "gradeFotos"
        );

    const info =
        document.getElementById(
            "galeriaInfo"
        );

    grade.innerHTML = "";

    info.innerText =
        `${lista.length} foto(s) encontrada(s)`;

    if (!lista.length) {

        grade.innerHTML =
            '<div class="sem-fotos">' +
            'Nenhuma foto encontrada.' +
            '</div>';

        return;
    }

    let atual = "";

    if (campoFotoDestino) {

        const campo =
            document.getElementById(
                campoFotoDestino
            );

        if (campo) {
            atual = campo.value;
        }
    }

    lista.forEach(
        nome => {

            const item =
                document.createElement(
                    "div"
                );

            item.className =
                "item-foto";

            if (nome === atual) {
                item.classList.add(
                    "selecionada"
                );
            }

            const imagem =
                document.createElement(
                    "img"
                );

            imagem.src =
                "/imagens/" +
                encodeURIComponent(nome);

            imagem.loading =
                "lazy";

            const titulo =
                document.createElement(
                    "div"
                );

            titulo.className =
                "nome-foto";

            titulo.innerText =
                nome;

            item.appendChild(imagem);
            item.appendChild(titulo);

            item.onclick =
                () => selecionarFoto(nome);

            grade.appendChild(item);
        }
    );
}


function selecionarFoto(nome) {

    if (!campoFotoDestino) return;

    const campo =
        document.getElementById(
            campoFotoDestino
        );

    if (!campo) return;

    campo.value = nome;

    fecharGaleria();
}


