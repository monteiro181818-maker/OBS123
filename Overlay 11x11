<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<title>11x11 Metreacts</title>

<style>

* {
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: transparent;
    font-family: Arial, sans-serif;
}


/* =========================
   QUADRO CENTRAL
========================= */

#comparacao {
    position: absolute;

    width: 720px;
    height: 540px;

    left: 50%;
    top: 47%;

    transform: translate(-50%, -50%);
}


/* =========================
   FUNDO PRETO
   ESCONDE O X ORIGINAL
========================= */

#fundo-comparacao {
    position: absolute;

    top: 55px;
    left: 0;

    width: 100%;
    height: 415px;

    background: #050509;

    z-index: 1;
}


/* =========================
   POSIÇÃO
========================= */

#posicao {
    position: absolute;

    top: 0;
    left: 50%;

    transform: translateX(-50%);

    padding: 7px 35px;

    color: white;
    background: #080810;

    border: 2px solid #704cff;
    border-radius: 8px;

    font-size: 27px;
    font-weight: 900;

    white-space: nowrap;

    z-index: 30;
}


/* =========================
   ÁREA DOS JOGADORES
========================= */

#jogadores {
    position: absolute;

    top: 55px;
    left: 0;

    width: 100%;
    height: 415px;

    display: flex;

    z-index: 5;
}


.jogador {
    position: relative;

    width: 50%;
    height: 100%;

    overflow: hidden;
}


/* =========================
   ÁREA DAS FOTOS
========================= */

.foto {
    position: absolute;

    width: 100%;
    height: 100%;

    left: 0;
    bottom: 0;

    overflow: hidden;
}


/* =========================
   VERBRUGGEN
========================= */

.esquerda .foto img {
    position: absolute;

    width: auto;
    height: 116%;

    max-width: none;

    left: 50%;
    bottom: -28px;

    transform: translateX(-50%);

    display: block;
}


/* =========================
   TER STEGEN
========================= */

.direita .foto img {
    position: absolute;

    width: auto;
    height: 135%;

    max-width: none;

    left: 50%;
    bottom: -35px;

    transform: translateX(-50%);

    display: block;
}


/* =========================
   SOMBRA INFERIOR
========================= */

.jogador::after {
    content: "";

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            to top,
            rgba(0,0,0,0.78) 0%,
            rgba(0,0,0,0.12) 27%,
            transparent 48%
        );

    pointer-events: none;

    z-index: 3;
}


/* =========================
   PLACAS DOS NOMES
========================= */

.nome-box {
    position: absolute;

    bottom: 0;

    width: 94%;
    height: 65px;

    background: rgba(5,5,10,0.96);

    display: flex;
    align-items: center;

    z-index: 10;
}


.esquerda .nome-box {
    left: 0;

    border: 2px solid #008cff;

    transform: skewX(12deg);
}


.direita .nome-box {
    right: 0;

    border: 2px solid #b400ff;

    transform: skewX(-12deg);
}


/* =========================
   CONTEÚDO DAS PLACAS
========================= */

.conteudo {
    width: 100%;

    padding: 0 18px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 12px;

    color: white;

    font-size: 25px;
    font-weight: 900;

    white-space: nowrap;
    overflow: hidden;
}


.esquerda .conteudo {
    transform: skewX(-12deg);
}


.direita .conteudo {
    transform: skewX(12deg);
}


/* =========================
   BANDEIRAS
========================= */

.bandeira {
    font-size: 27px;

    line-height: 1;

    flex-shrink: 0;
}


/* =========================
   NOME
========================= */

.nome {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}


/* =========================
   X BRANCO
========================= */

#versus {
    position: absolute;

    left: 50%;
    top: 48%;

    transform: translate(-50%, -50%);

    color: white;

    font-size: 72px;
    font-weight: 900;

    z-index: 25;

    text-shadow:
        -4px 0 #008cff,
         4px 0 #b400ff;
}

</style>
</head>


<body>

<div id="comparacao">


    <!-- FUNDO QUE ESCONDE O X ORIGINAL -->

    <div id="fundo-comparacao"></div>


    <!-- POSIÇÃO -->

    <div id="posicao">
        GOLEIRO
    </div>


    <!-- JOGADORES -->

    <div id="jogadores">


        <!-- HOLANDA -->

        <div class="jogador esquerda">

            <div class="foto">

                <img
                    src="../dados/fotos/holanda/verbruggen.png"
                    alt="Verbruggen"
                >

            </div>


            <div class="nome-box">

                <div class="conteudo">

                    <span class="bandeira">
                        🇳🇱
                    </span>

                    <span class="nome">
                        VERBRUGGEN
                    </span>

                </div>

            </div>

        </div>



        <!-- ALEMANHA -->

        <div class="jogador direita">

            <div class="foto">

                <img
                    src="../dados/fotos/alemanha/terstegen.png"
                    alt="Ter Stegen"
                >

            </div>


            <div class="nome-box">

                <div class="conteudo">

                    <span class="bandeira">
                        🇩🇪
                    </span>

                    <span class="nome">
                        TER STEGEN
                    </span>

                </div>

            </div>

        </div>


    </div>


    <!-- X CENTRAL -->

    <div id="versus">
        X
    </div>


</div>

</body>

</html>
