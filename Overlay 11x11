<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<title>11x11 Metreacts</title>

<style>

* {
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: transparent;
    font-family: Arial, sans-serif;
}

/* QUADRO CENTRAL */
#comparacao {
    position: absolute;

    width: 720px;
    height: 540px;

    left: 50%;
    top: 47%;

    transform: translate(-50%, -50%);
}

/* POSIÇÃO */
#posicao {
    position: absolute;
    top: 0;
    left: 50%;

    transform: translateX(-50%);

    padding: 7px 35px;

    color: white;
    background: rgba(5, 5, 15, 0.92);

    border: 2px solid #704cff;
    border-radius: 8px;

    font-size: 27px;
    font-weight: 900;

    white-space: nowrap;
}

/* ÁREA DOS JOGADORES */
#jogadores {
    position: absolute;

    top: 55px;
    left: 0;

    width: 100%;
    height: 415px;

    display: flex;
}

/* CADA METADE */
.jogador {
    position: relative;

    width: 50%;
    height: 100%;

    overflow: hidden;
}

/* ÁREA TEMPORÁRIA DA FOTO */
.foto {
    position: absolute;

    width: 88%;
    height: 88%;

    left: 50%;
    bottom: 0;

    transform: translateX(-50%);

    display: flex;
    justify-content: center;
    align-items: center;

    color: rgba(255,255,255,0.25);

    font-size: 25px;
    font-weight: bold;
}

/* PLACA DO NOME */
.nome-box {
    position: absolute;

    bottom: 0;

    width: 92%;
    height: 65px;

    background: rgba(5, 5, 10, 0.94);

    border: 2px solid white;

    display: flex;
    align-items: center;

    z-index: 5;
}

/* LADO ESQUERDO */
.esquerda .nome-box {
    left: 0;

    border-color: #008cff;

    transform: skewX(12deg);
}

/* LADO DIREITO */
.direita .nome-box {
    right: 0;

    border-color: #b400ff;

    transform: skewX(-12deg);
}

/* CORRIGE O TEXTO */
.esquerda .conteudo {
    transform: skewX(-12deg);
}

.direita .conteudo {
    transform: skewX(12deg);
}

.conteudo {
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0 15px;

    color: white;

    font-size: clamp(18px, 2vw, 30px);
    font-weight: 900;

    white-space: nowrap;
}

/* X CENTRAL */
#versus {
    position: absolute;

    left: 50%;
    top: 48%;

    transform: translate(-50%, -50%);

    color: white;

    font-size: 70px;
    font-weight: 900;

    z-index: 10;

    text-shadow:
        -3px 0 #008cff,
        3px 0 #b400ff;
}

</style>
</head>

<body>

<div id="comparacao">

    <div id="posicao">
        GOLEIRO
    </div>

    <div id="jogadores">

        <!-- JOGADOR 1 -->
        <div class="jogador esquerda">

            <div class="foto">
                FOTO 1
            </div>

            <div class="nome-box">
                <div class="conteudo">
                    ROSSI
                </div>
            </div>

        </div>

        <!-- JOGADOR 2 -->
        <div class="jogador direita">

            <div class="foto">
                FOTO 2
            </div>

            <div class="nome-box">
                <div class="conteudo">
                    LÉO JARDIM
                </div>
            </div>

        </div>

    </div>

    <div id="versus">
        X
    </div>

</div>

</body>
</html>
