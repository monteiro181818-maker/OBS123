<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<title>11x11 Metreacts</title>

<style>

* {
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: transparent;
    font-family: Arial, sans-serif;
}

/* =========================================
   QUADRO CENTRAL
========================================= */

#comparacao {
    position: absolute;

    width: 720px;
    height: 540px;

    left: 50%;
    top: 47%;

    transform: translate(-50%, -50%);
}


/* =========================================
   POSIÇÃO DO JOGADOR
========================================= */

#posicao {
    position: absolute;

    top: 0;
    left: 50%;

    transform: translateX(-50%);

    padding: 7px 35px;

    color: white;
    background: rgba(5, 5, 15, 0.92);

    border: 2px solid #704cff;
    border-radius: 8px;

    font-size: 27px;
    font-weight: 900;

    white-space: nowrap;

    z-index: 20;
}


/* =========================================
   ÁREA DOS JOGADORES
========================================= */

#jogadores {
    position: absolute;

    top: 55px;
    left: 0;

    width: 100%;
    height: 415px;

    display: flex;
}


/* =========================================
   CADA JOGADOR
========================================= */

.jogador {
    position: relative;

    width: 50%;
    height: 100%;

    overflow: hidden;
}


/* =========================================
   FOTO
========================================= */

.foto {
    position: absolute;

    width: 94%;
    height: 100%;

    left: 50%;
    bottom: 0;

    transform: translateX(-50%);

    overflow: hidden;
}


/* IMAGEM DO JOGADOR */

.foto img {
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center top;

    display: block;
}


/* FOTO 2 TEMPORÁRIA */

.placeholder {
    display: flex;

    align-items: center;
    justify-content: center;

    color: rgba(255,255,255,0.25);

    font-size: 25px;
    font-weight: 900;
}


/* =========================================
   SOMBREAMENTO NAS FOTOS
========================================= */

.jogador::after {
    content: "";

    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 100%;

    pointer-events: none;

    background:
        linear-gradient(
            to top,
            rgba(0,0,0,0.85) 0%,
            rgba(0,0,0,0.15) 35%,
            transparent 60%
        );
}


/* =========================================
   PLACA DO NOME
========================================= */

.nome-box {
    position: absolute;

    bottom: 0;

    width: 92%;
    height: 65px;

    background: rgba(5, 5, 10, 0.95);

    display: flex;
    align-items: center;

    z-index: 10;
}


/* HOLANDA / LADO ESQUERDO */

.esquerda .nome-box {
    left: 0;

    border: 2px solid #008cff;

    transform: skewX(12deg);
}


/* ALEMANHA / LADO DIREITO */

.direita .nome-box {
    right: 0;

    border: 2px solid #b400ff;

    transform: skewX(-12deg);
}


/* =========================================
   TEXTO DOS NOMES
========================================= */

.conteudo {
    width: 100%;

    padding: 0 15px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: white;

    font-size: 27px;
    font-weight: 900;

    white-space: nowrap;
    overflow: hidden;

    text-align: center;
}


/* CORRIGE A INCLINAÇÃO DAS PLACAS */

.esquerda .conteudo {
    transform: skewX(-12deg);
}

.direita .conteudo {
    transform: skewX(12deg);
}


/* =========================================
   X CENTRAL
========================================= */

#versus {
    position: absolute;

    left: 50%;
    top: 48%;

    transform: translate(-50%, -50%);

    color: white;

    font-size: 70px;
    font-weight: 900;

    z-index: 15;

    text-shadow:
        -3px 0 #008cff,
         3px 0 #b400ff;
}

</style>

</head>


<body>


<div id="comparacao">


    <!-- POSIÇÃO -->

    <div id="posicao">
        GOLEIRO
    </div>


    <!-- JOGADORES -->

    <div id="jogadores">


        <!-- =========================
             HOLANDA
        ========================== -->

        <div class="jogador esquerda">


            <div class="foto">

                <img
                    src="../dados/fotos/holanda/verbruggen.png"
                    alt="Verbruggen"
                >

            </div>


            <div class="nome-box">

                <div class="conteudo">
                    VERBRUGGEN
                </div>

            </div>


        </div>



        <!-- =========================
             ALEMANHA
        ========================== -->

        <div class="jogador direita">


            <div class="foto placeholder">

                FOTO 2

            </div>


            <div class="nome-box">

                <div class="conteudo">
                    GOLEIRO ALEMANHA
                </div>

            </div>


        </div>


    </div>


    <!-- X CENTRAL -->

    <div id="versus">
        X
    </div>


</div>


</body>

</html>
