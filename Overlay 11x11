<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>11x11 Metreacts</title>

<style>

html, body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: transparent;
    font-family: Arial, sans-serif;
}

#comparacao {
    position: absolute;

    /* ÁREA CENTRAL DO QUADRO */
    width: 850px;
    height: 650px;

    left: 50%;
    top: 50%;

    transform: translate(-50%, -50%);

    display: flex;
    flex-direction: column;
    align-items: center;
}

#posicao {
    color: white;
    font-size: 38px;
    font-weight: 900;
    margin-bottom: 35px;

    text-shadow: 0 3px 8px black;
}

#jogadores {
    width: 100%;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.jogador {
    width: 330px;

    display: flex;
    flex-direction: column;
    align-items: center;
}

.foto {
    width: 280px;
    height: 360px;

    object-fit: cover;

    border-radius: 15px;
}

.nome {
    margin-top: 15px;

    color: white;

    font-size: 30px;
    font-weight: 900;

    text-align: center;

    text-shadow: 0 3px 8px black;
}

</style>
</head>

<body>

<div id="comparacao">

    <div id="posicao">
        GOLEIRO
    </div>

    <div id="jogadores">

        <div class="jogador">

            <div class="foto"></div>

            <div class="nome">
                ROSSI
            </div>

        </div>

        <div class="jogador">

            <div class="foto"></div>

            <div class="nome">
                LÉO JARDIM
            </div>

        </div>

    </div>

</div>

</body>
</html>
