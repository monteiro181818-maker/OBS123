<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<title>11x11 Metreacts V2</title>

<style>

* {
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: transparent;
    font-family: Arial, sans-serif;
    color: white;
}

#layout {
    position: relative;
    width: 1920px;
    height: 1080px;
    overflow: hidden;

    background:
        radial-gradient(
            circle at center,
            rgba(70, 30, 130, 0.55),
            rgba(5, 7, 20, 0.97) 65%
        );
}


/* =====================================
   CÂMERAS
===================================== */

.camera {
    position: absolute;
    left: 45px;

    width: 420px;
    height: 330px;

    background: transparent;

    border: 4px solid #633cff;
    border-radius: 18px;

    box-shadow:
        0 0 20px rgba(100, 50, 255, 0.75);

    pointer-events: none;
}

#camera1 {
    top: 145px;
}

#camera2 {
    top: 575px;
}


/* =====================================
   COMPARAÇÃO
===================================== */

#comparacao {
    position: absolute;

    left: 510px;
    top: 145px;

    width: 810px;
    height: 700px;

    border: 3px solid #683cff;
    border-radius: 22px;

    background:
        linear-gradient(
            135deg,
            rgba(10,15,30,0.94),
            rgba(25,10,45,0.94)
        );

    box-shadow:
        0 0 30px rgba(105,50,255,0.50);

    overflow: hidden;
}


/* =====================================
   POSIÇÃO
===================================== */

#posicao {
    position: absolute;

    top: 20px;
    left: 50%;

    transform: translateX(-50%);

    padding: 8px 40px;

    background: #080812;

    border: 2px solid #704cff;
    border-radius: 10px;

    font-size: 29px;
    font-weight: 900;

    z-index: 20;

    white-space: nowrap;
}


/* =====================================
   JOGADORES
===================================== */

#jogadores {
    position: absolute;

    top: 90px;
    left: 25px;

    width: 754px;
    height: 500px;

    display: flex;
}

.jogador {
    position: relative;

    width: 50%;
    height: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    overflow: hidden;
}


/* =====================================
   FOTO DO JOGADOR
===================================== */

.foto-jogador {
    width: 300px;
    height: 410px;

    object-fit: contain;

    object-position: center bottom;

    display: block;

    z-index: 1;
}


/* =====================================
   X
===================================== */

#versus {
    position: absolute;

    left: 50%;
    top: 46%;

    transform: translate(-50%, -50%);

    font-size: 82px;
    font-weight: 900;

    z-index: 30;

    text-shadow:
        -4px 0 #168cff,
         4px 0 #ad24ff;
}


/* =====================================
   NOMES
===================================== */

.nome-jogador {
    position: absolute;

    bottom: 35px;

    width: 310px;
    height: 65px;

    display: flex;

    align-items: center;
    justify-content: center;

    background: rgba(5,5,12,0.96);

    font-size: 25px;
    font-weight: 900;

    border-radius: 8px;

    text-align: center;

    padding: 8px;

    z-index: 5;
}

.esquerda .nome-jogador {
    border: 2px solid #168cff;
}

.direita .nome-jogador {
    border: 2px solid #ad24ff;
}


/* =====================================
   PLACAR
===================================== */

#placar {
    position: absolute;

    left: 50%;
    bottom: 25px;

    transform: translateX(-50%);

    display: flex;
    align-items: center;

    gap: 28px;

    font-size: 30px;
    font-weight: 900;

    white-space: nowrap;
}

.numero {
    font-size: 42px;
}

.vs-placar {
    color: #9b6cff;
}


/* =====================================
   11 IDEAL
===================================== */

#campo-container {
    position: absolute;

    right: 40px;
    top: 145px;

    width: 515px;
    height: 760px;

    border: 3px solid #2ecf72;
    border-radius: 22px;

    background: rgba(5,25,18,0.93);

    box-shadow:
        0 0 30px rgba(25,210,105,0.30);

    overflow: hidden;
}

#campo-titulo {
    position: absolute;

    top: 18px;
    left: 50%;

    transform: translateX(-50%);

    font-size: 28px;
    font-weight: 900;

    white-space: nowrap;

    z-index: 20;
}


/* =====================================
   CAMPO
===================================== */

#campo {
    position: absolute;

    left: 25px;
    top: 75px;

    width: 459px;
    height: 650px;

    border: 3px solid rgba(255,255,255,0.75);
    border-radius: 12px;

    background:
        linear-gradient(
            to bottom,
            rgba(20,115,60,0.95),
            rgba(12,80,45,0.95)
        );
}

#campo::before {
    content: "";

    position: absolute;

    left: 0;
    top: 50%;

    width: 100%;
    height: 2px;

    background: rgba(255,255,255,0.70);
}

#campo::after {
    content: "";

    position: absolute;

    left: 50%;
    top: 50%;

    width: 110px;
    height: 110px;

    transform: translate(-50%, -50%);

    border: 2px solid rgba(255,255,255,0.70);
    border-radius: 50%;
}


/* =====================================
   JOGADORES NO 11 IDEAL
===================================== */

.jogador-campo {
    position: absolute;

    transform: translate(-50%, -50%);

    min-width: 90px;
    max-width: 125px;

    padding: 7px 9px;

    background: rgba(7,8,14,0.94);

    border: 2px solid #ffffff;

    border-radius: 9px;

    text-align: center;

    font-size: 12px;
    font-weight: 900;

    z-index: 10;

    box-shadow:
        0 3px 10px rgba(0,0,0,0.50);
}

.jogador-campo.lado1 {
    border-color: #168cff;
}

.jogador-campo.lado2 {
    border-color: #ad24ff;
}


/* =====================================
   POSIÇÕES DO 11 IDEAL
===================================== */

.pos-0 {
    left: 50%;
    top: 91%;
}

.pos-1 {
    left: 86%;
    top: 72%;
}

.pos-2 {
    left: 65%;
    top: 78%;
}

.pos-3 {
    left: 35%;
    top: 78%;
}

.pos-4 {
    left: 14%;
    top: 72%;
}

.pos-5 {
    left: 50%;
    top: 61%;
}

.pos-6 {
    left: 68%;
    top: 48%;
}

.pos-7 {
    left: 32%;
    top: 48%;
}

.pos-8 {
    left: 82%;
    top: 25%;
}

.pos-9 {
    left: 50%;
    top: 16%;
}

.pos-10 {
    left: 18%;
    top: 25%;
}


/* =====================================
   RODAPÉ
===================================== */

#rodape {
    position: absolute;

    left: 510px;
    bottom: 65px;

    width: 810px;

    text-align: center;

    font-size: 19px;

    color: rgba(255,255,255,0.50);

    letter-spacing: 3px;
}

</style>
</head>

<body>

<div id="layout">


    <!-- CÂMERAS -->

    <div id="camera1" class="camera"></div>

    <div id="camera2" class="camera"></div>


    <!-- COMPARAÇÃO -->

    <div id="comparacao">


        <div id="posicao">
            GOLEIRO
        </div>


        <div id="jogadores">


            <!-- JOGADOR 1 -->

            <div class="jogador esquerda">

                <img
                    id="fotoJogador1"
                    class="foto-jogador"
                    src="/imagens/verbruggen.png"
                    alt="Jogador 1"
                >

                <div
                    class="nome-jogador"
                    id="nomeJogador1">
                    VERBRUGGEN
                </div>

            </div>


            <!-- JOGADOR 2 -->

            <div class="jogador direita">

                <img
                    id="fotoJogador2"
                    class="foto-jogador"
                    src="/imagens/ter-stegen.png"
                    alt="Jogador 2"
                >

                <div
                    class="nome-jogador"
                    id="nomeJogador2">
                    TER STEGEN
                </div>

            </div>


        </div>


        <!-- X -->

        <div id="versus">
            X
        </div>


        <!-- PLACAR -->

        <div id="placar">

            <span id="nomeTime1">
                HOLANDA
            </span>

            <span
                class="numero"
                id="placar1">
                0
            </span>

            <span class="vs-placar">
                ×
            </span>

            <span
                class="numero"
                id="placar2">
                0
            </span>

            <span id="nomeTime2">
                ALEMANHA
            </span>

        </div>


    </div>


    <!-- 11 IDEAL -->

    <div id="campo-container">

        <div id="campo-titulo">
            11 IDEAL
        </div>

        <div id="campo"></div>

    </div>


    <div id="rodape">
        ESCOLHA POSIÇÃO POR POSIÇÃO
    </div>


</div>


<script>

/* =========================================
   ATUALIZAR OVERLAY
========================================= */

async function atualizarOverlay() {

    try {

        const resposta =
            await fetch(
                "/api/estado?tempo=" +
                Date.now()
            );


        const estado =
            await resposta.json();


        /* POSIÇÃO */

        document.getElementById(
            "posicao"
        ).innerText =
            estado.posicao || "GOLEIRO";


        /* NOMES */

        document.getElementById(
            "nomeJogador1"
        ).innerText =
            (
                estado.jogador1 ||
                "JOGADOR 1"
            ).toUpperCase();


        document.getElementById(
            "nomeJogador2"
        ).innerText =
            (
                estado.jogador2 ||
                "JOGADOR 2"
            ).toUpperCase();


        /* TIMES */

        document.getElementById(
            "nomeTime1"
        ).innerText =
            (
                estado.time1 ||
                "TIME 1"
            ).toUpperCase();


        document.getElementById(
            "nomeTime2"
        ).innerText =
            (
                estado.time2 ||
                "TIME 2"
            ).toUpperCase();


        /* PLACAR */

        document.getElementById(
            "placar1"
        ).innerText =
            estado.placar1 || 0;


        document.getElementById(
            "placar2"
        ).innerText =
            estado.placar2 || 0;


        /* 11 IDEAL */

        atualizarTimeIdeal(
            estado.timeIdeal || []
        );

    }

    catch (erro) {

        console.log(
            "Aguardando servidor..."
        );

    }

}


/* =========================================
   ATUALIZAR 11 IDEAL
========================================= */

function atualizarTimeIdeal(timeIdeal) {

    const campo =
        document.getElementById(
            "campo"
        );


    campo
        .querySelectorAll(
            ".jogador-campo"
        )
        .forEach(
            jogador =>
                jogador.remove()
        );


    timeIdeal.forEach(
        (item, indice) => {

            const jogador =
                document.createElement(
                    "div"
                );


            jogador.className =
                "jogador-campo " +
                "pos-" +
                indice +
                " " +
                (
                    item.lado === 1
                    ? "lado1"
                    : "lado2"
                );


            jogador.innerText =
                (
                    item.jogador ||
                    "JOGADOR"
                ).toUpperCase();


            campo.appendChild(
                jogador
            );

        }
    );

}


/* =========================================
   INICIAR
========================================= */

atualizarOverlay();

setInterval(
    atualizarOverlay,
    250
);

</script>

</body>

</html>
