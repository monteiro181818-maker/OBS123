<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>11x11 Metreacts</title>

<style>
* {
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: transparent;
    font-family: Arial, sans-serif;
}

/* QUADRO CENTRAL */
#comparacao {
    position: absolute;
    width: 720px;
    height: 540px;
    left: 50%;
    top: 47%;
    transform: translate(-50%, -50%);
}

/* FUNDO PRETO
   Serve para esconder o X azul/roxo da arte original */
#fundo-comparacao {
    position: absolute;
    top: 55px;
    left: 0;
    width: 100%;
    height: 415px;
    background: #050509;
    z-index: 1;
}

/* POSIÇÃO */
#posicao {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);

    padding: 7px 35px;

    color: white;
    background: #080810;

    border: 2px solid #704cff;
    border-radius: 8px;

    font-size: 27px;
    font-weight: 900;

    white-space: nowrap;

    z-index: 30;
}

/* ÁREA DOS JOGADORES */
#jogadores {
    position: absolute;
    top: 55px;
    left: 0;

    width: 100%;
    height: 415px;

    display: flex;

    z-index: 5;
}

.jogador {
    position: relative;
    width: 50%;
    height: 100%;
    overflow: hidden;
}

/* FOTO */
.foto {
    position: absolute;

    width: 100%;
    height: 100%;

    left: 0;
    bottom: 0;

    overflow: hidden;
}

.foto img {
    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: center bottom;

    display: block;
}

/* FOTO TEMPORÁRIA DA ALEMANHA */
.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;

    color: rgba(255,255,255,0.30);

    font-size: 24px;
    font-weight: 900;
}

/* SOMBRA NA PARTE DE BAIXO */
.jogador::after {
    content: "";

    position: absolute;
    inset: 0;

    background: linear-gradient(
        to top,
        rgba(0,0,0,0.80) 0%,
        rgba(0,0,0,0.15) 28%,
        transparent 50%
    );

    pointer-events: none;

    z-index: 3;
}

/* PLACAS */
.nome-box {
    position: absolute;

    bottom: 0;

    width: 94%;
    height: 65px;

    background: rgba(5,5,10,0.96);

    display: flex;
    align-items: center;

    z-index: 10;
}

.esquerda .nome-box {
    left: 0;
    border: 2px solid #008cff;
    transform: skewX(12deg);
}

.direita .nome-box {
    right: 0;
    border: 2px solid #b400ff;
    transform: skewX(-12deg);
}

.conteudo {
    width: 100%;

    padding: 0 15px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: white;

    font-size: 27px;
    font-weight: 900;

    white-space: nowrap;
    overflow: hidden;

    text-align: center;
}

.esquerda .conteudo {
    transform: skewX(-12deg);
}

.direita .conteudo {
    transform: skewX(12deg);
}

/* X NOVO */
#versus {
    position: absolute;

    left: 50%;
    top: 48%;

    transform: translate(-50%, -50%);

    color: white;

    font-size: 72px;
    font-weight: 900;

    z-index: 25;

    text-shadow:
        -4px 0 #008cff,
         4px 0 #b400ff;
}

</style>
</head>

<body>

<div id="comparacao">

    <!-- COBRE O X ORIGINAL -->
    <div id="fundo-comparacao"></div>

    <div id="posicao">
        GOLEIRO
    </div>

    <div id="jogadores">

        <!-- HOLANDA -->
        <div class="jogador esquerda">

            <div class="foto">
                <img
                    src="../dados/fotos/holanda/verbruggen.png"
                    alt="Verbruggen"
                >
            </div>

            <div class="nome-box">
                <div class="conteudo">
                    VERBRUGGEN
                </div>
            </div>

        </div>

        <!-- ALEMANHA -->
        <div class="jogador direita">

            <div class="foto placeholder">
                FOTO 2
            </div>

            <div class="nome-box">
                <div class="conteudo">
                    GOLEIRO ALEMANHA
                </div>
            </div>

        </div>

    </div>

    <!-- X QUE VAI PERMANECER -->
    <div id="versus">
        X
    </div>

</div>

</body>
</html>
