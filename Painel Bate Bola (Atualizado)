<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<title>Controle - Bate-Bola</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #111820;
    color: white;
    font-family: Arial, Helvetica, sans-serif;
}

.painel {
    width: 820px;
    margin: 40px auto 100px;
}

h1 {
    text-align: center;
}

.caixa {
    background: #1c2730;
    padding: 25px;
    border-radius: 15px;
    margin-top: 20px;
}

h2 {
    margin-top: 0;
}

label {
    display: block;
    margin-top: 15px;
    margin-bottom: 5px;
    color: #aaa;
}

input,
select {
    width: 100%;
    padding: 12px;
    border: 1px solid #45525c;
    border-radius: 7px;
    background: #0e1419;
    color: white;
    font-size: 17px;
}

select {
    cursor: pointer;
}

input[readonly] {
    background: #182027;
    color: #d7e0e6;
}

/* LISTA */

.jogoConfig {
    display: grid;
    grid-template-columns: 55px 1fr 35px 1fr 45px;
    gap: 10px;
    align-items: center;
    margin-top: 12px;
}

.numeroJogo {
    text-align: center;
    font-weight: bold;
    color: #8ea0ad;
}

.versus {
    text-align: center;
    font-size: 20px;
    font-weight: bold;
}

/* JOGO ATUAL */

.statusJogo {
    text-align: center;
    padding: 16px;
    margin-bottom: 20px;
    background: #111820;
    border-radius: 8px;
    color: white;
    font-size: 18px;
    font-weight: bold;
}

.confrontoAtual {
    display: grid;
    grid-template-columns: 1fr 50px 1fr;
    gap: 10px;
    align-items: end;
}

.xAtual {
    text-align: center;
    font-size: 27px;
    font-weight: bold;
    padding-bottom: 10px;
}

/* PLACAR */

.placar {
    display: flex;
    align-items: center;
    gap: 10px;
}

.placar input {
    width: 80px;
    text-align: center;
    font-size: 24px;
    font-weight: bold;
}

.x {
    font-size: 24px;
}

/* BOTÕES */

button {
    margin-top: 15px;
    padding: 13px 18px;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
}

button:hover:not(:disabled) {
    filter: brightness(1.1);
}

button:disabled {
    opacity: .35;
    cursor: not-allowed;
}

.adicionar {
    width: 100%;
    background: #555f68;
    color: white;
}

.remover {
    margin: 0;
    padding: 10px;
    background: #b92d3a;
    color: white;
}

.iniciar {
    width: 100%;
    background: #6f42c1;
    color: white;
}

.salvar {
    width: 100%;
    background: #28a745;
    color: white;
}

.revelar {
    background: white;
    color: black;
}

.revelado {
    background: #28a745 !important;
    color: white !important;
}

.navegacao {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 25px;
}

.anterior {
    width: 100%;
    background: #555f68;
    color: white;
    margin-top: 0;
}

.proximo {
    width: 100%;
    background: #2675d8;
    color: white;
    margin-top: 0;
}

.finalizar {
    width: 100%;
    background: #d58b19;
    color: white;
}

.novaRodada {
    width: 100%;
    background: #b92d3a;
    color: white;
}

.aviso {
    text-align: center;
    margin-top: 12px;
    color: #9dacb7;
    font-size: 14px;
}

</style>
</head>

<body>

<div class="painel">

<h1>⚽ BATE-BOLA DA RODADA</h1>


<div class="caixa">

<h2>Apresentadores</h2>

<label>Seu nome</label>

<input
    id="nome1"
    value="MATHEUS"
    oninput="mudouPainel()"
>

<label>Nome do parceiro</label>

<input
    id="nome2"
    value="THALYSON"
    oninput="mudouPainel()"
>

</div>


<div class="caixa">

<h2>Jogos da rodada</h2>

<p style="color:#9dacb7;">
Escolha todos os confrontos antes da gravação.
</p>

<div id="listaJogos"></div>

<button
    class="adicionar"
    onclick="adicionarJogo()"
>
+ ADICIONAR CONFRONTO
</button>

<button
    class="iniciar"
    onclick="iniciarRodada()"
>
INICIAR / CARREGAR RODADA
</button>

</div>


<div class="caixa">

<h2>Confronto atual</h2>

<div
    class="statusJogo"
    id="statusJogo"
>
JOGO 1
</div>

<div class="confrontoAtual">

<div>

<label>Mandante</label>

<input
    id="casa"
    readonly
>

</div>

<div class="xAtual">
×
</div>

<div>

<label>Visitante</label>

<input
    id="visitante"
    readonly
>

</div>

</div>

</div>


<div class="caixa">

<h2 id="tituloPalpite1">
Palpite - MATHEUS
</h2>

<div class="placar">

<input
    id="p1casa"
    type="number"
    min="0"
    oninput="alterouPalpite()"
>

<span class="x">×</span>

<input
    id="p1fora"
    type="number"
    min="0"
    oninput="alterouPalpite()"
>

</div>

<button
    id="btnRevelar1"
    class="revelar"
    onclick="revelar1()"
>
REVELAR PALPITE MATHEUS
</button>

</div>


<div class="caixa">

<h2 id="tituloPalpite2">
Palpite - THALYSON
</h2>

<div class="placar">

<input
    id="p2casa"
    type="number"
    min="0"
    oninput="alterouPalpite()"
>

<span class="x">×</span>

<input
    id="p2fora"
    type="number"
    min="0"
    oninput="alterouPalpite()"
>

</div>

<button
    id="btnRevelar2"
    class="revelar"
    onclick="revelar2()"
>
REVELAR PALPITE THALYSON
</button>

</div>


<button
    class="salvar"
    onclick="salvar()"
>
ATUALIZAR CONFRONTO
</button>


<div class="navegacao">

<button
    class="anterior"
    id="btnAnterior"
    onclick="anterior()"
>
◀ JOGO ANTERIOR
</button>

<button
    class="proximo"
    id="btnProximo"
    onclick="proximo()"
>
PRÓXIMO JOGO ▶
</button>

</div>


<div
    class="aviso"
    id="avisoProximo"
>
Revele os dois palpites para liberar o próximo jogo.
</div>


<button
    class="finalizar"
    id="btnFinalizar"
    onclick="finalizar()"
>
FINALIZAR RODADA
</button>


<button
    class="novaRodada"
    onclick="novaRodada()"
>
NOVA RODADA
</button>

</div>


<script>

const CHAVE_SALVAMENTO =
    "metreacts_batebola_estado_v2";


const clubes = [

    "ATHLETICO-PR",
    "ATLÉTICO-MG",
    "BAHIA",
    "BOTAFOGO",
    "CHAPECOENSE",
    "CORINTHIANS",
    "CORITIBA",
    "CRUZEIRO",
    "FLAMENGO",
    "FLUMINENSE",
    "GRÊMIO",
    "INTERNACIONAL",
    "MIRASSOL",
    "PALMEIRAS",
    "RED BULL BRAGANTINO",
    "REMO",
    "SANTOS",
    "SÃO PAULO",
    "VASCO",
    "VITÓRIA"

];


function jogosPadrao() {

    return [

        {
            casa: "FLAMENGO",
            visitante: "VASCO"
        },

        {
            casa: "PALMEIRAS",
            visitante: "CORINTHIANS"
        },

        {
            casa: "FLUMINENSE",
            visitante: "BOTAFOGO"
        }

    ];

}


let jogos =
    jogosPadrao();

let jogoAtual = 0;

let resultados = [];

/*
Cada jogo possui seu próprio estado.
Isso permite voltar para jogos anteriores.
*/

let estadosJogos = [];


/* =========================
   ESTADO DE UM JOGO
========================= */

function novoEstadoJogo() {

    return {

        p1casa: "",
        p1fora: "",

        p2casa: "",
        p2fora: "",

        revelou1: false,
        revelou2: false

    };

}


function garantirEstados() {

    while (
        estadosJogos.length <
        jogos.length
    ) {

        estadosJogos.push(
            novoEstadoJogo()
        );

    }


    if (
        estadosJogos.length >
        jogos.length
    ) {

        estadosJogos =
            estadosJogos.slice(
                0,
                jogos.length
            );

    }

}


/* =========================
   CLUBES
========================= */

function criarOpcoes(
    selecionado
) {

    let html =
        `<option value="">Selecione...</option>`;


    clubes.forEach(
        function(clube) {

            const marcado =
                clube === selecionado
                ? "selected"
                : "";


            html += `

                <option
                    value="${clube}"
                    ${marcado}
                >
                    ${clube}
                </option>

            `;

        }
    );


    return html;

}


/* =========================
   LISTA DE JOGOS
========================= */

function desenharListaJogos() {

    const lista =
        document.getElementById(
            "listaJogos"
        );


    lista.innerHTML = "";


    jogos.forEach(
        function(jogo, indice) {

            const linha =
                document.createElement(
                    "div"
                );


            linha.className =
                "jogoConfig";


            linha.innerHTML = `

                <div class="numeroJogo">
                    ${indice + 1}
                </div>

                <select
                    id="configCasa${indice}"
                    onchange="mudouListaJogos()"
                >

                    ${criarOpcoes(
                        jogo.casa
                    )}

                </select>

                <div class="versus">
                    ×
                </div>

                <select
                    id="configVisitante${indice}"
                    onchange="mudouListaJogos()"
                >

                    ${criarOpcoes(
                        jogo.visitante
                    )}

                </select>

                <button
                    class="remover"
                    onclick="removerJogo(${indice})"
                >
                    ×
                </button>

            `;


            lista.appendChild(
                linha
            );

        }
    );

}


/* =========================
   LÊ JOGOS
========================= */

function lerJogosDaTela() {

    const novosJogos = [];


    for (
        let i = 0;
        i < jogos.length;
        i++
    ) {

        novosJogos.push({

            casa:
                document
                    .getElementById(
                        "configCasa" + i
                    )
                    .value,

            visitante:
                document
                    .getElementById(
                        "configVisitante" + i
                    )
                    .value

        });

    }


    jogos =
        novosJogos;

}


function mudouListaJogos() {

    lerJogosDaTela();

    garantirEstados();

    salvarEstado();

}


/* =========================
   ADICIONAR / REMOVER
========================= */

function adicionarJogo() {

    lerJogosDaTela();


    jogos.push({

        casa: "",
        visitante: ""

    });


    estadosJogos.push(
        novoEstadoJogo()
    );


    desenharListaJogos();

    salvarEstado();

}


function removerJogo(indice) {

    if (
        jogos.length <= 1
    ) {

        alert(
            "A rodada precisa ter pelo menos um confronto."
        );

        return;

    }


    lerJogosDaTela();


    jogos.splice(
        indice,
        1
    );


    estadosJogos.splice(
        indice,
        1
    );


    resultados.splice(
        indice,
        1
    );


    if (
        jogoAtual >=
        jogos.length
    ) {

        jogoAtual =
            jogos.length - 1;

    }


    desenharListaJogos();

    carregarJogo();

    salvarEstado();

}


/* =========================
   VALIDA RODADA
========================= */

function validarRodada() {

    for (
        let i = 0;
        i < jogos.length;
        i++
    ) {

        if (
            !jogos[i].casa ||
            !jogos[i].visitante
        ) {

            alert(
                "Selecione mandante e visitante em todos os jogos."
            );

            return false;

        }


        if (
            jogos[i].casa ===
            jogos[i].visitante
        ) {

            alert(
                "O jogo " +
                (i + 1) +
                " possui o mesmo clube dos dois lados."
            );

            return false;

        }

    }


    return true;

}


/* =========================
   INICIAR
========================= */

async function iniciarRodada() {

    lerJogosDaTela();


    if (
        !validarRodada()
    ) {

        return;

    }


    jogoAtual = 0;

    resultados = [];

    estadosJogos =
        jogos.map(
            function() {

                return novoEstadoJogo();

            }
        );


    carregarJogo();

    salvarEstado();


    await enviar(
        "atualizar"
    );

}


/* =========================
   SALVA JOGO ATUAL
========================= */

function salvarEstadoJogoAtual() {

    garantirEstados();


    const estado =
        estadosJogos[
            jogoAtual
        ];


    estado.p1casa =
        document
            .getElementById(
                "p1casa"
            )
            .value;


    estado.p1fora =
        document
            .getElementById(
                "p1fora"
            )
            .value;


    estado.p2casa =
        document
            .getElementById(
                "p2casa"
            )
            .value;


    estado.p2fora =
        document
            .getElementById(
                "p2fora"
            )
            .value;

}


/* =========================
   CARREGA JOGO
========================= */

function carregarJogo() {

    garantirEstados();


    const jogo =
        jogos[jogoAtual];


    const estado =
        estadosJogos[
            jogoAtual
        ];


    if (
        !jogo ||
        !estado
    ) {

        return;

    }


    document
        .getElementById(
            "casa"
        )
        .value =
            jogo.casa;


    document
        .getElementById(
            "visitante"
        )
        .value =
            jogo.visitante;


    document
        .getElementById(
            "p1casa"
        )
        .value =
            estado.p1casa;


    document
        .getElementById(
            "p1fora"
        )
        .value =
            estado.p1fora;


    document
        .getElementById(
            "p2casa"
        )
        .value =
            estado.p2casa;


    document
        .getElementById(
            "p2fora"
        )
        .value =
            estado.p2fora;


    document
        .getElementById(
            "statusJogo"
        )
        .textContent =

            "JOGO " +
            (jogoAtual + 1) +
            " DE " +
            jogos.length +
            " — " +
            jogo.casa +
            " × " +
            jogo.visitante;


    atualizarNomesPalpites();

    atualizarBotoes();

}


/* =========================
   NOMES
========================= */

function mudouPainel() {

    atualizarNomesPalpites();

    salvarEstado();

}


function atualizarNomesPalpites() {

    const nome1 =
        document
            .getElementById(
                "nome1"
            )
            .value
            .trim()
            .toUpperCase() ||
            "MATHEUS";


    const nome2 =
        document
            .getElementById(
                "nome2"
            )
            .value
            .trim()
            .toUpperCase() ||
            "THALYSON";


    document
        .getElementById(
            "tituloPalpite1"
        )
        .textContent =
            "Palpite - " +
            nome1;


    document
        .getElementById(
            "tituloPalpite2"
        )
        .textContent =
            "Palpite - " +
            nome2;


    atualizarBotoes();

}


/* =========================
   PALPITE ALTERADO
========================= */

function alterouPalpite() {

    salvarEstadoJogoAtual();

    salvarEstado();

}


/* =========================
   BOTÕES DE REVELAÇÃO
========================= */

function atualizarBotoes() {

    garantirEstados();


    const estado =
        estadosJogos[
            jogoAtual
        ];


    if (!estado) {
        return;
    }


    const nome1 =
        document
            .getElementById(
                "nome1"
            )
            .value
            .trim()
            .toUpperCase() ||
            "MATHEUS";


    const nome2 =
        document
            .getElementById(
                "nome2"
            )
            .value
            .trim()
            .toUpperCase() ||
            "THALYSON";


    const btn1 =
        document.getElementById(
            "btnRevelar1"
        );


    const btn2 =
        document.getElementById(
            "btnRevelar2"
        );


    if (
        estado.revelou1
    ) {

        btn1.textContent =
            "✓ " +
            nome1 +
            " REVELADO";

        btn1.classList.add(
            "revelado"
        );

    }

    else {

        btn1.textContent =
            "REVELAR PALPITE " +
            nome1;

        btn1.classList.remove(
            "revelado"
        );

    }


    if (
        estado.revelou2
    ) {

        btn2.textContent =
            "✓ " +
            nome2 +
            " REVELADO";

        btn2.classList.add(
            "revelado"
        );

    }

    else {

        btn2.textContent =
            "REVELAR PALPITE " +
            nome2;

        btn2.classList.remove(
            "revelado"
        );

    }


    const ambosRevelados =
        estado.revelou1 &&
        estado.revelou2;


    document
        .getElementById(
            "btnProximo"
        )
        .disabled =
            !ambosRevelados;


    document
        .getElementById(
            "btnAnterior"
        )
        .disabled =
            jogoAtual === 0;


    /*
    FINALIZAR SÓ NO ÚLTIMO JOGO
    E COM OS DOIS REVELADOS
    */

    document
        .getElementById(
            "btnFinalizar"
        )
        .disabled = !(

            jogoAtual ===
            jogos.length - 1

            &&

            ambosRevelados

        );


    document
        .getElementById(
            "avisoProximo"
        )
        .style
        .display =
            ambosRevelados
            ? "none"
            : "block";

}


/* =========================
   DADOS
========================= */

function dados() {

    return {

        nome1:
            document
                .getElementById(
                    "nome1"
                )
                .value
                .trim() ||
                "MATHEUS",

        nome2:
            document
                .getElementById(
                    "nome2"
                )
                .value
                .trim() ||
                "THALYSON",

        casa:
            document
                .getElementById(
                    "casa"
                )
                .value,

        visitante:
            document
                .getElementById(
                    "visitante"
                )
                .value,

        p1casa:
            document
                .getElementById(
                    "p1casa"
                )
                .value,

        p1fora:
            document
                .getElementById(
                    "p1fora"
                )
                .value,

        p2casa:
            document
                .getElementById(
                    "p2casa"
                )
                .value,

        p2fora:
            document
                .getElementById(
                    "p2fora"
                )
                .value

    };

}


/* =========================
   PALPITES PREENCHIDOS
========================= */

function palpite1Preenchido() {

    const d =
        dados();


    return (

        d.p1casa !== "" &&
        d.p1fora !== ""

    );

}


function palpite2Preenchido() {

    const d =
        dados();


    return (

        d.p2casa !== "" &&
        d.p2fora !== ""

    );

}


function palpitesPreenchidos() {

    return (

        palpite1Preenchido() &&
        palpite2Preenchido()

    );

}


/* =========================
   ENVIA SERVIDOR
========================= */

async function enviar(acao) {

    const pacote = {

        acao: acao,

        dados: dados(),

        resultados:
            resultados

    };


    try {

        const resposta =
            await fetch(

                "/api/comando",

                {
                    method:
                        "POST",

                    headers: {

                        "Content-Type":
                            "application/json"

                    },

                    body:
                        JSON.stringify(
                            pacote
                        )

                }

            );


        const resultado =
            await resposta.json();


        if (
            !resultado.ok
        ) {

            alert(
                "Erro ao enviar comando."
            );

        }


    } catch (erro) {

        alert(
            "Não foi possível comunicar com o servidor."
        );

        console.error(
            erro
        );

    }

}


/* =========================
   ATUALIZAR
========================= */

function salvar() {

    salvarEstadoJogoAtual();

    salvarEstado();

    enviar(
        "atualizar"
    );

}


/* =========================
   REVELAR MATHEUS
========================= */

async function revelar1() {

    if (
        !palpite1Preenchido()
    ) {

        alert(
            "Preencha o palpite do MATHEUS antes de revelar."
        );

        return;

    }


    salvarEstadoJogoAtual();


    estadosJogos[
        jogoAtual
    ].revelou1 =
        true;


    salvarEstado();

    atualizarBotoes();


    await enviar(
        "revelar1"
    );

}


/* =========================
   REVELAR THALYSON
========================= */

async function revelar2() {

    if (
        !palpite2Preenchido()
    ) {

        alert(
            "Preencha o palpite do THALYSON antes de revelar."
        );

        return;

    }


    salvarEstadoJogoAtual();


    estadosJogos[
        jogoAtual
    ].revelou2 =
        true;


    salvarEstado();

    atualizarBotoes();


    await enviar(
        "revelar2"
    );

}


/* =========================
   GUARDA RESULTADO
========================= */

function guardarResultadoAtual() {

    salvarEstadoJogoAtual();


    const d =
        dados();


    resultados[
        jogoAtual
    ] = {

        casa:
            d.casa,

        visitante:
            d.visitante,

        nome1:
            d.nome1,

        nome2:
            d.nome2,

        palpite1:
            d.p1casa +
            " × " +
            d.p1fora,

        palpite2:
            d.p2casa +
            " × " +
            d.p2fora

    };


    salvarEstado();

}


/* =========================
   PRÓXIMO
========================= */

async function proximo() {

    const estado =
        estadosJogos[
            jogoAtual
        ];


    if (
        !palpitesPreenchidos() ||
        !estado.revelou1 ||
        !estado.revelou2
    ) {

        alert(
            "Preencha e revele os dois palpites antes de continuar."
        );

        return;

    }


    guardarResultadoAtual();


    await enviar(
        "proximo"
    );


    if (
        jogoAtual <
        jogos.length - 1
    ) {

        jogoAtual++;


        carregarJogo();

        salvarEstado();


        await enviar(
            "atualizar"
        );

    }

}


/* =========================
   JOGO ANTERIOR
========================= */

async function anterior() {

    if (
        jogoAtual === 0
    ) {

        return;

    }


    salvarEstadoJogoAtual();


    jogoAtual--;


    carregarJogo();

    salvarEstado();


    await enviar(
        "atualizar"
    );


    /*
    Se os palpites desse jogo
    já tinham sido revelados,
    revela novamente no overlay.
    */

    const estado =
        estadosJogos[
            jogoAtual
        ];


    if (
        estado.revelou1
    ) {

        await enviar(
            "revelar1"
        );

    }


    if (
        estado.revelou2
    ) {

        await enviar(
            "revelar2"
        );

    }

}


/* =========================
   FINALIZAR
========================= */

async function finalizar() {

    const estado =
        estadosJogos[
            jogoAtual
        ];


    if (
        jogoAtual !==
        jogos.length - 1
    ) {

        alert(
            "A rodada só pode ser finalizada no último jogo."
        );

        return;

    }


    if (
        !palpitesPreenchidos() ||
        !estado.revelou1 ||
        !estado.revelou2
    ) {

        alert(
            "Preencha e revele os dois palpites antes de finalizar."
        );

        return;

    }


    guardarResultadoAtual();


    await enviar(
        "finalizar"
    );


    salvarEstado();

}


/* =========================
   SALVAMENTO AUTOMÁTICO
========================= */

function salvarEstado() {

    try {

        const estado = {

            nome1:
                document
                    .getElementById(
                        "nome1"
                    )
                    .value,

            nome2:
                document
                    .getElementById(
                        "nome2"
                    )
                    .value,

            jogos:
                jogos,

            jogoAtual:
                jogoAtual,

            resultados:
                resultados,

            estadosJogos:
                estadosJogos

        };


        localStorage.setItem(

            CHAVE_SALVAMENTO,

            JSON.stringify(
                estado
            )

        );


    } catch (erro) {

        console.error(
            "Erro ao salvar:",
            erro
        );

    }

}


/* =========================
   RECUPERA SALVAMENTO
========================= */

function recuperarEstado() {

    try {

        const salvo =
            localStorage.getItem(
                CHAVE_SALVAMENTO
            );


        if (!salvo) {

            return false;

        }


        const estado =
            JSON.parse(
                salvo
            );


        if (
            Array.isArray(
                estado.jogos
            ) &&
            estado.jogos.length
        ) {

            jogos =
                estado.jogos;

        }


        if (
            Array.isArray(
                estado.resultados
            )
        ) {

            resultados =
                estado.resultados;

        }


        if (
            Array.isArray(
                estado.estadosJogos
            )
        ) {

            estadosJogos =
                estado.estadosJogos;

        }


        jogoAtual =
            Number.isInteger(
                estado.jogoAtual
            )
            ? estado.jogoAtual
            : 0;


        if (
            jogoAtual < 0 ||
            jogoAtual >=
            jogos.length
        ) {

            jogoAtual = 0;

        }


        document
            .getElementById(
                "nome1"
            )
            .value =
                estado.nome1 ||
                "MATHEUS";


        document
            .getElementById(
                "nome2"
            )
            .value =
                estado.nome2 ||
                "THALYSON";


        garantirEstados();


        return true;


    } catch (erro) {

        console.error(
            "Erro ao recuperar:",
            erro
        );


        return false;

    }

}


/* =========================
   NOVA RODADA
========================= */

async function novaRodada() {

    const confirmar =
        confirm(
            "Deseja iniciar uma nova rodada? Todos os confrontos e palpites salvos serão apagados."
        );


    if (
        !confirmar
    ) {

        return;

    }


    localStorage.removeItem(
        CHAVE_SALVAMENTO
    );


    jogos =
        jogosPadrao();


    jogoAtual = 0;

    resultados = [];


    estadosJogos =
        jogos.map(
            function() {

                return novoEstadoJogo();

            }
        );


    document
        .getElementById(
            "nome1"
        )
        .value =
            "MATHEUS";


    document
        .getElementById(
            "nome2"
        )
        .value =
            "THALYSON";


    desenharListaJogos();

    carregarJogo();

    salvarEstado();


    await enviar(
        "atualizar"
    );

}


/* =========================
   INICIALIZAÇÃO
========================= */

const recuperou =
    recuperarEstado();


if (
    !recuperou
) {

    estadosJogos =
        jogos.map(
            function() {

                return novoEstadoJogo();

            }
        );

}


desenharListaJogos();

carregarJogo();

atualizarNomesPalpites();

</script>

