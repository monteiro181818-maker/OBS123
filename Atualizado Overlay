<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<title>Bate-Bola da Rodada</title>

<style>

* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #050505;
    font-family: Arial, Helvetica, sans-serif;
}

/* =========================
   ESTÁDIO
========================= */

.estadio {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;

    background:
        radial-gradient(
            ellipse at center top,
            #35434c 0%,
            #182128 35%,
            #080b0e 75%
        );
}

/* FOTO REAL DO ESTÁDIO */

.fundoEstadio {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    opacity: 0;

    transform: scale(1.04);

    transition:
        opacity .8s ease,
        transform 8s ease;

    z-index: 1;
}

.fundoEstadio.visivel {
    opacity: 1;
    transform: scale(1.10);
}


/* =========================
   ESTÁDIO GENÉRICO
========================= */

.arquibancada {
    position: absolute;
    top: 8%;
    left: 5%;
    right: 5%;
    height: 42%;

    border-radius: 50% 50% 15% 15%;

    background:
        repeating-linear-gradient(
            0deg,
            #28343b 0px,
            #28343b 5px,
            #1b252b 6px,
            #1b252b 13px
        );

    box-shadow:
        inset 0 0 80px #000,
        0 20px 80px #000;

    z-index: 0;
}

.luzes {
    position: absolute;
    top: 9%;
    left: 10%;
    right: 10%;
    height: 5px;

    background: white;

    box-shadow:
        0 0 15px white,
        0 0 35px rgba(255,255,255,.5);

    z-index: 0;
}

.gramado {
    position: absolute;
    left: -15%;
    right: -15%;
    bottom: -30%;
    height: 70%;

    transform:
        perspective(600px)
        rotateX(45deg);

    background:
        repeating-linear-gradient(
            90deg,
            #155d2c 0px,
            #155d2c 100px,
            #176b33 101px,
            #176b33 200px
        );

    border:
        3px solid
        rgba(255,255,255,.3);

    z-index: 0;
}

.linha {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 3px;

    background:
        rgba(255,255,255,.35);
}

.circulo {
    position: absolute;
    left: 50%;
    top: 50%;

    width: 180px;
    height: 180px;

    transform:
        translate(-50%, -50%);

    border:
        3px solid
        rgba(255,255,255,.35);

    border-radius: 50%;
}


/* =========================
   CAMADAS SOBRE A FOTO
========================= */

.escurecerEstadio {
    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            to bottom,
            rgba(0,0,0,.35),
            rgba(0,0,0,.18) 45%,
            rgba(0,0,0,.55)
        );

    z-index: 2;

    pointer-events: none;
}

.vinheta {
    position: absolute;
    inset: 0;

    background:
        radial-gradient(
            circle,
            transparent 30%,
            rgba(0,0,0,.72) 100%
        );

    z-index: 3;

    pointer-events: none;
}


/* =========================
   CONTEÚDO
========================= */

.conteudo {
    position: absolute;
    inset: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;
    color: white;

    z-index: 10;
}

.titulo {
    font-size: 20px;
    letter-spacing: 6px;
    font-weight: bold;

    opacity: .9;

    margin-bottom: 25px;

    text-shadow:
        0 3px 15px black;
}


/* =========================
   CONFRONTO + ESCUDOS
========================= */

.confronto {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 30px;

    width: 90%;

    font-size: 58px;
    font-weight: 900;
    letter-spacing: 3px;

    text-shadow:
        0 5px 25px black,
        0 2px 5px black;

    animation:
        aparecer 1.2s ease-out;
}

.timeConfronto {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 20px;

    min-width: 420px;
}

.escudoTime {
    width: 125px;
    height: 125px;

    object-fit: contain;

    filter:
        drop-shadow(
            0 8px 15px
            rgba(0,0,0,.8)
        );
}

.nomeTime {
    white-space: nowrap;
}

.x {
    opacity: .7;
    margin: 0 10px;

    font-size: 65px;
}


/* =========================
   PALPITES
========================= */

.palpites {
    display: flex;
    gap: 80px;

    margin-top: 55px;
}

.palpite {
    min-width: 300px;

    padding:
        22px 35px;

    border-radius: 16px;

    background:
        rgba(0,0,0,.68);

    border:
        1px solid
        rgba(255,255,255,.25);

    opacity: 0;

    transform:
        translateY(35px)
        scale(.9);

    box-shadow:
        0 10px 35px
        rgba(0,0,0,.55);
}

.palpite.visivel {
    animation:
        revelar .7s
        ease-out forwards;
}

.nome {
    font-size: 17px;
    letter-spacing: 4px;
    font-weight: bold;

    opacity: .8;
}

.placar {
    margin-top: 8px;

    font-size: 55px;
    font-weight: 900;
}


/* =========================
   ANIMAÇÕES
========================= */

@keyframes aparecer {

    from {
        opacity: 0;
        transform: scale(.8);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}

@keyframes revelar {

    from {
        opacity: 0;

        transform:
            translateY(35px)
            scale(.9);
    }

    to {
        opacity: 1;

        transform:
            translateY(0)
            scale(1);
    }
}


/* =========================
   RESUMO FINAL
========================= */

.resumo {
    position: fixed;
    inset: 0;

    display: none;

    flex-direction: column;
    align-items: center;
    justify-content: center;

    background:
        radial-gradient(
            circle at top,
            #263640,
            #080b0e 65%
        );

    color: white;

    z-index: 100;
}

.resumo.visivel {
    display: flex;

    animation:
        aparecerResumo
        .7s ease-out;
}

.resumoTitulo {
    font-size: 46px;
    font-weight: 900;
    letter-spacing: 6px;

    margin-bottom: 45px;

    text-shadow:
        0 5px 25px black;
}

.tabelaResumo {
    width: 82%;
    max-width: 1500px;

    background:
        rgba(0,0,0,.55);

    border:
        1px solid
        rgba(255,255,255,.2);

    border-radius: 18px;

    overflow: hidden;

    box-shadow:
        0 20px 70px
        rgba(0,0,0,.5);
}

.cabecalhoResumo,
.linhaResumo {

    display: grid;

    grid-template-columns:
        2fr 1fr 1fr;

    align-items: center;

    text-align: center;
}

.cabecalhoResumo {

    padding:
        20px 25px;

    font-size: 18px;

    font-weight: bold;

    letter-spacing: 2px;

    background:
        rgba(255,255,255,.10);
}

.linhaResumo {

    padding:
        23px 25px;

    font-size: 25px;

    border-top:
        1px solid
        rgba(255,255,255,.12);
}

.confrontoResumo {
    text-align: left;
    font-weight: bold;
}

.placarResumo {
    font-size: 29px;
    font-weight: 900;
}

@keyframes aparecerResumo {

    from {
        opacity: 0;
        transform: scale(.96);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}

</style>
</head>


<body>


<div class="estadio">

    <!-- FOTO REAL DO ESTÁDIO -->

    <img
        id="fundoEstadio"
        class="fundoEstadio"
        src=""
        alt=""
    >


    <!-- FUNDO GENÉRICO -->

    <div class="arquibancada"></div>

    <div class="luzes"></div>

    <div class="gramado">

        <div class="linha"></div>

        <div class="circulo"></div>

    </div>


    <!-- CAMADAS DE CONTRASTE -->

    <div class="escurecerEstadio"></div>

    <div class="vinheta"></div>


    <!-- CONTEÚDO -->

    <div class="conteudo">


        <div class="titulo">
            BATE-BOLA DA RODADA
        </div>


        <div class="confronto">


            <div class="timeConfronto">

                <img
                    id="escudoCasa"
                    class="escudoTime"
                    src="/escudos/flamengo.png"
                >

                <span
                    id="nomeCasa"
                    class="nomeTime"
                >
                    FLAMENGO
                </span>

            </div>


            <span class="x">
                ×
            </span>


            <div class="timeConfronto">

                <span
                    id="nomeVisitante"
                    class="nomeTime"
                >
                    VASCO
                </span>

                <img
                    id="escudoVisitante"
                    class="escudoTime"
                    src="/escudos/vasco.png"
                >

            </div>


        </div>


        <div class="palpites">


            <div
                class="palpite"
                id="palpiteMts"
            >

                <div class="nome">
                    PALPITE DO MTS
                </div>

                <div class="placar">
                    2 × 1
                </div>

            </div>


            <div
                class="palpite"
                id="palpiteAmigo"
            >

                <div class="nome">
                    PALPITE DO AMIGO
                </div>

                <div class="placar">
                    1 × 1
                </div>

            </div>


        </div>


    </div>

</div>


<!-- =========================
     RESUMO FINAL
========================= -->

<div
    class="resumo"
    id="resumo"
>

    <div class="resumoTitulo">
        BATE-BOLA DA RODADA
    </div>


    <div class="tabelaResumo">


        <div class="cabecalhoResumo">

            <div>
                CONFRONTO
            </div>

            <div id="cabNome1">
                MTS
            </div>

            <div id="cabNome2">
                AMIGO
            </div>

        </div>


        <div id="linhasResumo"></div>


    </div>

</div>



<script>


/* =========================
   CONTROLE DO SERVIDOR
========================= */

let ultimaVersao = -1;


/* =========================
   ESCUDOS
========================= */

function nomeArquivoTime(nome) {

    return nome

        .normalize("NFD")

        .replace(
            /[\u0300-\u036f]/g,
            ""
        )

        .toLowerCase()

        .trim()

        .replace(
            /\s+/g,
            "-"
        );
}


function atualizarEscudos(
    casa,
    visitante
) {

    const arquivoCasa =
        nomeArquivoTime(casa);

    const arquivoVisitante =
        nomeArquivoTime(visitante);


    document.getElementById(
        "escudoCasa"
    ).src =
        "/escudos/" +
        arquivoCasa +
        ".png";


    document.getElementById(
        "escudoVisitante"
    ).src =
        "/escudos/" +
        arquivoVisitante +
        ".png";
}


/* =========================
   ESTÁDIOS
========================= */

/*
Por enquanto temos apenas um estádio configurado.

Depois vamos acrescentar os demais.
*/

function atualizarEstadio(
    casa,
    visitante
) {

    const fundo =
        document.getElementById(
            "fundoEstadio"
        );


    const mandante =
        casa
        .trim()
        .toUpperCase();


    const adversario =
        visitante
        .trim()
        .toUpperCase();


    /*
    TESTE 1:
    FLAMENGO X VASCO
    */

    if (
        mandante === "FLAMENGO" &&
        adversario === "VASCO"
    ) {

        fundo.classList.remove(
            "visivel"
        );


        fundo.src =
            "/estadios/maracana.jpg";


        fundo.onload =
            function() {

                fundo.classList.add(
                    "visivel"
                );

            };


        return;

    }


    /*
    SE AINDA NÃO EXISTIR
    ESTÁDIO CONFIGURADO,
    VOLTA AO FUNDO GENÉRICO
    */

    fundo.classList.remove(
        "visivel"
    );

}


/* =========================
   PALPITES
========================= */

function revelarMts() {

    document
        .getElementById(
            "palpiteMts"
        )
        .classList
        .add("visivel");
}


function revelarAmigo() {

    document
        .getElementById(
            "palpiteAmigo"
        )
        .classList
        .add("visivel");
}


function reiniciar() {

    document
        .getElementById(
            "palpiteMts"
        )
        .classList
        .remove("visivel");


    document
        .getElementById(
            "palpiteAmigo"
        )
        .classList
        .remove("visivel");
}


/* =========================
   ATUALIZAR CONFRONTO
========================= */

function atualizarDados(d) {


    document.getElementById(
        "nomeCasa"
    ).textContent =
        d.casa;


    document.getElementById(
        "nomeVisitante"
    ).textContent =
        d.visitante;


    /* ESCUDOS */

    atualizarEscudos(
        d.casa,
        d.visitante
    );


    /* ESTÁDIO */

    atualizarEstadio(
        d.casa,
        d.visitante
    );


    /* NOMES DOS PALPITES */

    document.querySelector(
        "#palpiteMts .nome"
    ).textContent =
        "PALPITE DO " +
        d.nome1.toUpperCase();


    document.querySelector(
        "#palpiteAmigo .nome"
    ).textContent =
        "PALPITE DO " +
        d.nome2.toUpperCase();


    /* PLACARES */

    document.querySelector(
        "#palpiteMts .placar"
    ).textContent =
        d.p1casa +
        " × " +
        d.p1fora;


    document.querySelector(
        "#palpiteAmigo .placar"
    ).textContent =
        d.p2casa +
        " × " +
        d.p2fora;

}


/* =========================
   RESUMO FINAL
========================= */

function mostrarResumo(pacote) {


    const resultados =
        pacote.resultados || [];


    if (
        resultados.length === 0
    ) {

        return;

    }


    const primeiro =
        resultados[0];


    document.getElementById(
        "cabNome1"
    ).textContent =
        primeiro.nome1
        .toUpperCase();


    document.getElementById(
        "cabNome2"
    ).textContent =
        primeiro.nome2
        .toUpperCase();


    const linhas =
        document.getElementById(
            "linhasResumo"
        );


    linhas.innerHTML = "";


    resultados.forEach(
        function(resultado) {


            const linha =
                document.createElement(
                    "div"
                );


            linha.className =
                "linhaResumo";


            const confronto =
                document.createElement(
                    "div"
                );


            confronto.className =
                "confrontoResumo";


            confronto.textContent =
                resultado.casa +
                " × " +
                resultado.visitante;


            const palpite1 =
                document.createElement(
                    "div"
                );


            palpite1.className =
                "placarResumo";


            palpite1.textContent =
                resultado.palpite1;


            const palpite2 =
                document.createElement(
                    "div"
                );


            palpite2.className =
                "placarResumo";


            palpite2.textContent =
                resultado.palpite2;


            linha.appendChild(
                confronto
            );


            linha.appendChild(
                palpite1
            );


            linha.appendChild(
                palpite2
            );


            linhas.appendChild(
                linha
            );

        }
    );


    document
        .getElementById(
            "resumo"
        )
        .classList
        .add("visivel");

}


/* =========================
   COMUNICAÇÃO COM SERVIDOR
========================= */

async function verificarServidor() {


    try {


        const resposta =
            await fetch(

                "/api/estado?t=" +
                Date.now(),

                {
                    cache:
                        "no-store"
                }

            );


        const pacote =
            await resposta.json();


        if (
            pacote.versao !==
            ultimaVersao
        ) {


            ultimaVersao =
                pacote.versao;


            atualizarDados(
                pacote.dados
            );


            if (
                pacote.acao ===
                "atualizar"
            ) {

                reiniciar();


                document
                    .getElementById(
                        "resumo"
                    )
                    .classList
                    .remove(
                        "visivel"
                    );

            }


            if (
                pacote.acao ===
                "revelar1"
            ) {

                revelarMts();

            }


            if (
                pacote.acao ===
                "revelar2"
            ) {

                revelarAmigo();

            }


            if (
                pacote.acao ===
                "proximo"
            ) {

                reiniciar();


                document
                    .getElementById(
                        "resumo"
                    )
                    .classList
                    .remove(
                        "visivel"
                    );

            }


            if (
                pacote.acao ===
                "finalizar"
            ) {

                mostrarResumo(
                    pacote
                );

            }

        }


    } catch (erro) {


        console.error(
            "Erro de comunicação:",
            erro
        );


    }

}


/* VERIFICA O SERVIDOR
   5 VEZES POR SEGUNDO */

setInterval(
    verificarServidor,
    200
);


verificarServidor();


</script>

</body>
</html>
