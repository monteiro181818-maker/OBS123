<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<title>Bate-Bola da Rodada</title>

<style>

* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #050505;
    font-family: Arial, Helvetica, sans-serif;
}

/* =========================
   ESTÁDIO
========================= */

.estadio {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;

    background:
        radial-gradient(
            ellipse at center top,
            #35434c 0%,
            #182128 35%,
            #080b0e 75%
        );
}

/* FOTO REAL */

.fundoEstadio {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    opacity: 0;

    transform: scale(1.04);

    transition:
        opacity .8s ease,
        transform 8s ease;

    z-index: 1;
}

.fundoEstadio.visivel {
    opacity: 1;
    transform: scale(1.10);
}

/* =========================
   FUNDO GENÉRICO
========================= */

.arquibancada {
    position: absolute;
    top: 8%;
    left: 5%;
    right: 5%;
    height: 42%;

    border-radius: 50% 50% 15% 15%;

    background:
        repeating-linear-gradient(
            0deg,
            #28343b 0px,
            #28343b 5px,
            #1b252b 6px,
            #1b252b 13px
        );

    box-shadow:
        inset 0 0 80px #000,
        0 20px 80px #000;

    z-index: 0;
}

.luzes {
    position: absolute;
    top: 9%;
    left: 10%;
    right: 10%;
    height: 5px;

    background: white;

    box-shadow:
        0 0 15px white,
        0 0 35px rgba(255,255,255,.5);

    z-index: 0;
}

.gramado {
    position: absolute;
    left: -15%;
    right: -15%;
    bottom: -30%;
    height: 70%;

    transform:
        perspective(600px)
        rotateX(45deg);

    background:
        repeating-linear-gradient(
            90deg,
            #155d2c 0px,
            #155d2c 100px,
            #176b33 101px,
            #176b33 200px
        );

    border:
        3px solid
        rgba(255,255,255,.3);

    z-index: 0;
}

.linha {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 3px;

    background:
        rgba(255,255,255,.35);
}

.circulo {
    position: absolute;
    left: 50%;
    top: 50%;

    width: 180px;
    height: 180px;

    transform:
        translate(-50%, -50%);

    border:
        3px solid
        rgba(255,255,255,.35);

    border-radius: 50%;
}

/* =========================
   CAMADAS
========================= */

.escurecerEstadio {
    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            to bottom,
            rgba(0,0,0,.35),
            rgba(0,0,0,.18) 45%,
            rgba(0,0,0,.55)
        );

    z-index: 2;

    pointer-events: none;
}

.vinheta {
    position: absolute;
    inset: 0;

    background:
        radial-gradient(
            circle,
            transparent 30%,
            rgba(0,0,0,.72) 100%
        );

    z-index: 3;

    pointer-events: none;
}

/* =========================
   CONTEÚDO
========================= */

.conteudo {
    position: absolute;
    inset: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;
    color: white;

    z-index: 10;
}

.titulo {
    font-size: 20px;
    letter-spacing: 6px;
    font-weight: bold;

    opacity: .9;

    margin-bottom: 25px;

    text-shadow:
        0 3px 15px black;
}

/* =========================
   CONFRONTO
========================= */

.confronto {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 30px;

    width: 90%;

    font-size: 58px;
    font-weight: 900;
    letter-spacing: 3px;

    text-shadow:
        0 5px 25px black,
        0 2px 5px black;

    animation:
        aparecer 1.2s ease-out;
}

.timeConfronto {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 20px;

    min-width: 420px;
}

.escudoTime {
    width: 125px;
    height: 125px;

    object-fit: contain;

    filter:
        drop-shadow(
            0 8px 15px
            rgba(0,0,0,.8)
        );
}

.nomeTime {
    white-space: nowrap;
}

.x {
    opacity: .7;

    margin: 0 10px;

    font-size: 65px;
}

/* =========================
   PALPITES
========================= */

.palpites {
    display: flex;

    gap: 80px;

    margin-top: 55px;
}

.palpite {
    min-width: 300px;

    padding:
        22px 35px;

    border-radius: 16px;

    background:
        rgba(0,0,0,.68);

    border:
        1px solid
        rgba(255,255,255,.25);

    opacity: 0;

    transform:
        translateY(35px)
        scale(.9);

    box-shadow:
        0 10px 35px
        rgba(0,0,0,.55);
}

.palpite.visivel {
    animation:
        revelar .7s
        ease-out forwards;
}

.nome {
    font-size: 17px;
    letter-spacing: 4px;
    font-weight: bold;

    opacity: .8;
}

.placar {
    margin-top: 8px;

    font-size: 55px;
    font-weight: 900;
}

/* =========================
   ANIMAÇÕES
========================= */

@keyframes aparecer {

    from {
        opacity: 0;
        transform: scale(.8);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}

@keyframes revelar {

    from {
        opacity: 0;

        transform:
            translateY(35px)
            scale(.9);
    }

    to {
        opacity: 1;

        transform:
            translateY(0)
            scale(1);
    }
}

/* =========================
   RESUMO FINAL
========================= */

.resumo {
    position: fixed;
    inset: 0;

    display: none;

    flex-direction: column;
    align-items: center;
    justify-content: center;

    background:
        radial-gradient(
            circle at top,
            #263640,
            #080b0e 65%
        );

    color: white;

    z-index: 100;
}

.resumo.visivel {
    display: flex;

    animation:
        aparecerResumo
        .7s ease-out;
}

.resumoTitulo {
    font-size: 46px;
    font-weight: 900;
    letter-spacing: 6px;

    margin-bottom: 45px;

    text-shadow:
        0 5px 25px black;
}

.tabelaResumo {
    width: 82%;
    max-width: 1500px;

    background:
        rgba(0,0,0,.55);

    border:
        1px solid
        rgba(255,255,255,.2);

    border-radius: 18px;

    overflow: hidden;

    box-shadow:
        0 20px 70px
        rgba(0,0,0,.5);
}

.cabecalhoResumo,
.linhaResumo {
    display: grid;

    grid-template-columns:
        2fr 1fr 1fr;

    align-items: center;

    text-align: center;
}

.cabecalhoResumo {
    padding:
        20px 25px;

    font-size: 18px;

    font-weight: bold;

    letter-spacing: 2px;

    background:
        rgba(255,255,255,.10);
}

.linhaResumo {
    padding:
        23px 25px;

    font-size: 25px;

    border-top:
        1px solid
        rgba(255,255,255,.12);
}

.confrontoResumo {
    text-align: left;
    font-weight: bold;
}

.placarResumo {
    font-size: 29px;
    font-weight: 900;
}

@keyframes aparecerResumo {

    from {
        opacity: 0;
        transform: scale(.96);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}

</style>
</head>


<body>

<div class="estadio">

    <img
        id="fundoEstadio"
        class="fundoEstadio"
        src=""
        alt=""
    >

    <div class="arquibancada"></div>

    <div class="luzes"></div>

    <div class="gramado">

        <div class="linha"></div>

        <div class="circulo"></div>

    </div>

    <div class="escurecerEstadio"></div>

    <div class="vinheta"></div>


    <div class="conteudo">

        <div class="titulo">
            BATE-BOLA DA RODADA
        </div>


        <div class="confronto">

            <div class="timeConfronto">

                <img
                    id="escudoCasa"
                    class="escudoTime"
                    src="/escudos/flamengo.png"
                >

                <span
                    id="nomeCasa"
                    class="nomeTime"
                >
                    FLAMENGO
                </span>

            </div>


            <span class="x">
                ×
            </span>


            <div class="timeConfronto">

                <span
                    id="nomeVisitante"
                    class="nomeTime"
                >
                    VASCO
                </span>

                <img
                    id="escudoVisitante"
                    class="escudoTime"
                    src="/escudos/vasco.png"
                >

            </div>

        </div>


        <div class="palpites">

            <div
                class="palpite"
                id="palpiteMts"
            >

                <div class="nome">
                    PALPITE DO MTS
                </div>

                <div class="placar">
                    2 × 1
                </div>

            </div>


            <div
                class="palpite"
                id="palpiteAmigo"
            >

                <div class="nome">
                    PALPITE DO AMIGO
                </div>

                <div class="placar">
                    1 × 1
                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================
     RESUMO FINAL
========================= -->

<div
    class="resumo"
    id="resumo"
>

    <div class="resumoTitulo">
        BATE-BOLA DA RODADA
    </div>


    <div class="tabelaResumo">

        <div class="cabecalhoResumo">

            <div>
                CONFRONTO
            </div>

            <div id="cabNome1">
                MTS
            </div>

            <div id="cabNome2">
                AMIGO
            </div>

        </div>


        <div id="linhasResumo"></div>

    </div>

</div>


<script>

/* =========================
   SERVIDOR
========================= */

let ultimaVersao = -1;


/* =========================
   PADRONIZAÇÃO DOS NOMES
========================= */

function normalizarTime(nome) {

    return String(nome || "")

        .normalize("NFD")

        .replace(
            /[\u0300-\u036f]/g,
            ""
        )

        .toUpperCase()

        .trim()

        .replace(
            /\s+/g,
            "-"
        );
}


/* =========================
   MAPA DOS 20 CLUBES
========================= */

const clubes = {

    "ATHLETICO-PARANAENSE": {
        escudo:
            "/escudos/athletico-paranaense.png",

        estadio:
            "/estadios/arena-da-baixada.jpg"
    },


    "ATLETICO-MINEIRO": {
        escudo:
            "/escudos/atletico-mineiro.png",

        estadio:
            "/estadios/arena-mrv.jpg"
    },


    "BAHIA": {
        escudo:
            "/escudos/bahia.png",

        estadio:
            "/estadios/fonte-nova.jpg"
    },


    "BOTAFOGO": {
        escudo:
            "/escudos/botafogo.png",

        estadio:
            "/estadios/nilton-santos.jpg"
    },


    "CHAPECOENSE": {
        escudo:
            "/escudos/chapecoense.png",

        estadio:
            "/estadios/arena-conda.jpg"
    },


    "CORINTHIANS": {
        escudo:
            "/escudos/corinthians.png",

        estadio:
            "/estadios/neo-quimica-arena.jpg"
    },


    "CORITIBA": {
        escudo:
            "/escudos/coritiba.png",

        estadio:
            "/estadios/couto-pereira.jpg"
    },


    "CRUZEIRO": {
        escudo:
            "/escudos/cruzeiro.png",

        estadio:
            "/estadios/mineirao.jpg"
    },


    "FLAMENGO": {
        escudo:
            "/escudos/flamengo.png",

        estadio:
            "/estadios/maracana.jpg"
    },


    "FLUMINENSE": {
        escudo:
            "/escudos/fluminense.png",

        estadio:
            "/estadios/maracana.jpg"
    },


    "GREMIO": {
        escudo:
            "/escudos/gremio.png",

        estadio:
            "/estadios/arena-do-gremio.jpg"
    },


    "INTERNACIONAL": {
        escudo:
            "/escudos/internacional.png",

        estadio:
            "/estadios/beira-rio.jpg"
    },


    "MIRASSOL": {
        escudo:
            "/escudos/mirassol.png",

        estadio:
            "/estadios/jose-maria-de-campos-maia.jpg"
    },


    "PALMEIRAS": {
        escudo:
            "/escudos/palmeiras.png",

        estadio:
            "/estadios/allianz-parque.jpg"
    },


    "RED-BULL-BRAGANTINO": {
        escudo:
            "/escudos/red-bull-bragantino.png",

        estadio:
            "/estadios/cicero-de-souza-marques.jpg"
    },


    "REMO": {
        escudo:
            "/escudos/remo.png",

        estadio:
            "/estadios/mangueirao.jpg"
    },


    "SANTOS": {
        escudo:
            "/escudos/santos.png",

        estadio:
            "/estadios/vila-belmiro.jpg"
    },


    "SAO-PAULO": {
        escudo:
            "/escudos/sao-paulo.png",

        estadio:
            "/estadios/morumbis.jpg"
    },


    "VASCO": {
        escudo:
            "/escudos/vasco.png",

        estadio:
            "/estadios/sao-januario.jpg"
    },


    "VITORIA": {
        escudo:
            "/escudos/vitoria.png",

        estadio:
            "/estadios/barradao.jpg"
    }

};


/* =========================
   APELIDOS / FORMAS DE DIGITAR
========================= */

const apelidos = {

    "ATHLETICO-PR":
        "ATHLETICO-PARANAENSE",

    "ATHLETICO":
        "ATHLETICO-PARANAENSE",

    "ATLETICO-MG":
        "ATLETICO-MINEIRO",

    "ATLETICO":
        "ATLETICO-MINEIRO",

    "RED-BULL-BRAGANTINO":
        "RED-BULL-BRAGANTINO",

    "BRAGANTINO":
        "RED-BULL-BRAGANTINO",

    "RB-BRAGANTINO":
        "RED-BULL-BRAGANTINO",

    "SAO-PAULO":
        "SAO-PAULO",

    "SPFC":
        "SAO-PAULO",

    "GREMIO":
        "GREMIO",

    "VITORIA":
        "VITORIA"

};


/* =========================
   LOCALIZA O CLUBE
========================= */

function identificarClube(nome) {

    const chave =
        normalizarTime(nome);


    const chaveFinal =
        apelidos[chave] ||
        chave;


    return clubes[chaveFinal] || null;
}


/* =========================
   ESCUDOS
========================= */

function atualizarEscudos(
    casa,
    visitante
) {

    const clubeCasa =
        identificarClube(casa);


    const clubeVisitante =
        identificarClube(visitante);


    const escudoCasa =
        document.getElementById(
            "escudoCasa"
        );


    const escudoVisitante =
        document.getElementById(
            "escudoVisitante"
        );


    if (clubeCasa) {

        escudoCasa.src =
            clubeCasa.escudo;

        escudoCasa.style.display =
            "block";

    } else {

        escudoCasa.style.display =
            "none";

    }


    if (clubeVisitante) {

        escudoVisitante.src =
            clubeVisitante.escudo;

        escudoVisitante.style.display =
            "block";

    } else {

        escudoVisitante.style.display =
            "none";

    }

}


/* =========================
   ESTÁDIO
========================= */

function atualizarEstadio(casa) {

    const fundo =
        document.getElementById(
            "fundoEstadio"
        );


    const clubeCasa =
        identificarClube(casa);


    if (
        !clubeCasa ||
        !clubeCasa.estadio
    ) {

        fundo.classList.remove(
            "visivel"
        );

        fundo.removeAttribute(
            "src"
        );

        return;
    }


    const imagemEstadio =
        clubeCasa.estadio;


    fundo.classList.remove(
        "visivel"
    );


    fundo.onload =
        function() {

            fundo.classList.add(
                "visivel"
            );

        };


    fundo.onerror =
        function() {

            console.error(
                "Erro ao carregar estádio:",
                imagemEstadio
            );

            fundo.classList.remove(
                "visivel"
            );

        };


    fundo.src =
        imagemEstadio;

}


/* =========================
   PALPITES
========================= */

function revelarMts() {

    document
        .getElementById(
            "palpiteMts"
        )
        .classList
        .add(
            "visivel"
        );
}


function revelarAmigo() {

    document
        .getElementById(
            "palpiteAmigo"
        )
        .classList
        .add(
            "visivel"
        );
}


function reiniciar() {

    document
        .getElementById(
            "palpiteMts"
        )
        .classList
        .remove(
            "visivel"
        );


    document
        .getElementById(
            "palpiteAmigo"
        )
        .classList
        .remove(
            "visivel"
        );
}


/* =========================
   ATUALIZA CONFRONTO
========================= */

function atualizarDados(d) {

    if (!d) {
        return;
    }


    document.getElementById(
        "nomeCasa"
    ).textContent =
        d.casa || "";


    document.getElementById(
        "nomeVisitante"
    ).textContent =
        d.visitante || "";


    atualizarEscudos(
        d.casa,
        d.visitante
    );


    atualizarEstadio(
        d.casa
    );


    document.querySelector(
        "#palpiteMts .nome"
    ).textContent =
        "PALPITE DO " +
        String(
            d.nome1 || "MTS"
        ).toUpperCase();


    document.querySelector(
        "#palpiteAmigo .nome"
    ).textContent =
        "PALPITE DO " +
        String(
            d.nome2 || "AMIGO"
        ).toUpperCase();


    document.querySelector(
        "#palpiteMts .placar"
    ).textContent =
        (d.p1casa || "0") +
        " × " +
        (d.p1fora || "0");


    document.querySelector(
        "#palpiteAmigo .placar"
    ).textContent =
        (d.p2casa || "0") +
        " × " +
        (d.p2fora || "0");

}


/* =========================
   RESUMO FINAL
========================= */

function mostrarResumo(pacote) {

    const resultados =
        pacote.resultados || [];


    if (
        resultados.length === 0
    ) {

        return;

    }


    const primeiro =
        resultados[0];


    document.getElementById(
        "cabNome1"
    ).textContent =
        String(
            primeiro.nome1 ||
            "MTS"
        ).toUpperCase();


    document.getElementById(
        "cabNome2"
    ).textContent =
        String(
            primeiro.nome2 ||
            "AMIGO"
        ).toUpperCase();


    const linhas =
        document.getElementById(
            "linhasResumo"
        );


    linhas.innerHTML = "";


    resultados.forEach(
        function(resultado) {


            const linha =
                document.createElement(
                    "div"
                );


            linha.className =
                "linhaResumo";


            const confronto =
                document.createElement(
                    "div"
                );


            confronto.className =
                "confrontoResumo";


            confronto.textContent =
                resultado.casa +
                " × " +
                resultado.visitante;


            const palpite1 =
                document.createElement(
                    "div"
                );


            palpite1.className =
                "placarResumo";


            palpite1.textContent =
                resultado.palpite1;


            const palpite2 =
                document.createElement(
                    "div"
                );


            palpite2.className =
                "placarResumo";


            palpite2.textContent =
                resultado.palpite2;


            linha.appendChild(
                confronto
            );


            linha.appendChild(
                palpite1
            );


            linha.appendChild(
                palpite2
            );


            linhas.appendChild(
                linha
            );

        }
    );


    document
        .getElementById(
            "resumo"
        )
        .classList
        .add(
            "visivel"
        );

}


/* =========================
   SERVIDOR
========================= */

async function verificarServidor() {

    try {


        const resposta =
            await fetch(

                "/api/estado?t=" +
                Date.now(),

                {
                    cache:
                        "no-store"
                }

            );


        if (!resposta.ok) {

            throw new Error(
                "Servidor respondeu " +
                resposta.status
            );

        }


        const pacote =
            await resposta.json();


        if (
            pacote.versao !==
            ultimaVersao
        ) {


            ultimaVersao =
                pacote.versao;


            atualizarDados(
                pacote.dados
            );


            if (
                pacote.acao ===
                "atualizar"
            ) {

                reiniciar();


                document
                    .getElementById(
                        "resumo"
                    )
                    .classList
                    .remove(
                        "visivel"
                    );

            }


            if (
                pacote.acao ===
                "revelar1"
            ) {

                revelarMts();

            }


            if (
                pacote.acao ===
                "revelar2"
            ) {

                revelarAmigo();

            }


            if (
                pacote.acao ===
                "proximo"
            ) {

                reiniciar();


                document
                    .getElementById(
                        "resumo"
                    )
                    .classList
                    .remove(
                        "visivel"
                    );

            }


            if (
                pacote.acao ===
                "finalizar"
            ) {

                mostrarResumo(
                    pacote
                );

            }

        }


    } catch (erro) {


        console.error(
            "Erro de comunicação:",
            erro
        );

    }

}


/* VERIFICA 5 VEZES POR SEGUNDO */

setInterval(
    verificarServidor,
    200
);


verificarServidor();

</script>

</body>
</html>
