<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<title>11x11 Metreacts V2</title>

<style>

* {
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: transparent;
    font-family: Arial, sans-serif;
    color: white;
}

#layout {
    position: relative;
    width: 1920px;
    height: 1080px;
    overflow: hidden;

    background:
        radial-gradient(
            circle at center,
            rgba(70,30,130,0.55),
            rgba(5,7,20,0.97) 65%
        );
}


/* ==================================================
   CÂMERAS
================================================== */

.camera {
    position: absolute;
    left: 45px;

    width: 420px;
    height: 330px;

    background: transparent;

    border: 4px solid #633cff;
    border-radius: 18px;

    box-shadow:
        0 0 20px
        rgba(100,50,255,0.75);

    pointer-events: none;
}

#camera1 {
    top: 145px;
}

#camera2 {
    top: 575px;
}


/* ==================================================
   COMPARAÇÃO NORMAL
================================================== */

#comparacao {
    position: absolute;

    left: 510px;
    top: 145px;

    width: 810px;
    height: 700px;

    border: 3px solid #683cff;
    border-radius: 22px;

    background:
        linear-gradient(
            135deg,
            rgba(10,15,30,0.94),
            rgba(25,10,45,0.94)
        );

    box-shadow:
        0 0 30px
        rgba(105,50,255,0.50);

    overflow: hidden;
}

#posicao {
    position: absolute;

    top: 20px;
    left: 50%;

    transform:
        translateX(-50%);

    padding: 8px 40px;

    background: #080812;

    border:
        2px solid #704cff;

    border-radius: 10px;

    font-size: 29px;
    font-weight: 900;

    z-index: 20;

    white-space: nowrap;
}


/* ==================================================
   JOGADORES DA COMPARAÇÃO
================================================== */

#jogadores {
    position: absolute;

    top: 90px;
    left: 25px;

    width: 754px;
    height: 500px;

    display: flex;
}

.jogador {
    position: relative;

    width: 50%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    transition:
        opacity 0.35s ease,
        filter 0.35s ease;
}

.foto-jogador {
    width: 300px;
    height: 410px;

    object-fit: cover;
    object-position: center top;

    display: block;

    border-radius: 4px;

    z-index: 1;

    transition:
        transform 0.35s ease,
        filter 0.35s ease,
        box-shadow 0.35s ease;
}


/* ==================================================
   PARTE 11 - JOGADOR ESCOLHIDO
================================================== */

.selo-escolhido {
    position: absolute;

    top: 35px;
    left: 50%;

    transform:
        translateX(-50%) scale(0.75);

    min-width: 185px;

    padding: 10px 18px;

    border-radius: 9px;

    text-align: center;

    font-size: 19px;
    font-weight: 900;

    letter-spacing: 1px;

    color: white;

    opacity: 0;

    z-index: 15;

    pointer-events: none;

    transition:
        opacity 0.30s ease,
        transform 0.30s ease;
}

.esquerda .selo-escolhido {
    background:
        rgba(22,140,255,0.95);

    border:
        2px solid #73bdff;

    box-shadow:
        0 0 22px
        rgba(22,140,255,0.75);
}

.direita .selo-escolhido {
    background:
        rgba(173,36,255,0.95);

    border:
        2px solid #d28aff;

    box-shadow:
        0 0 22px
        rgba(173,36,255,0.75);
}


/* VENCEDOR */

.jogador.vencedor
.foto-jogador {
    transform:
        scale(1.045);
}

.jogador.esquerda.vencedor
.foto-jogador {
    box-shadow:
        0 0 18px #168cff,
        0 0 38px rgba(22,140,255,0.75);
}

.jogador.direita.vencedor
.foto-jogador {
    box-shadow:
        0 0 18px #ad24ff,
        0 0 38px rgba(173,36,255,0.75);
}

.jogador.vencedor
.selo-escolhido {
    opacity: 1;

    transform:
        translateX(-50%) scale(1);
}


/* PERDEDOR */

.jogador.perdedor {
    opacity: 0.42;

    filter:
        grayscale(55%);
}

.jogador.perdedor
.foto-jogador {
    transform:
        scale(0.96);
}


/* NOME DO VENCEDOR */

.jogador.vencedor
.nome-jogador {
    transform:
        scale(1.035);
}

.jogador.esquerda.vencedor
.nome-jogador {
    box-shadow:
        0 0 18px
        rgba(22,140,255,0.75);
}

.jogador.direita.vencedor
.nome-jogador {
    box-shadow:
        0 0 18px
        rgba(173,36,255,0.75);
}


/* ==================================================
   X CENTRAL
================================================== */

#versus {
