<script>


/* ==================================================
   ATUALIZAR FOTO
================================================== */

function atualizarFoto(
    elemento,
    nomeArquivo
) {

    if (
        !nomeArquivo ||
        nomeArquivo.trim() === ""
    ) {

        elemento.style.display =
            "none";

        elemento.removeAttribute(
            "src"
        );

        elemento.dataset.foto =
            "";

        return;

    }


    elemento.style.display =
        "block";


    if (
        elemento.dataset.foto !==
        nomeArquivo
    ) {

        elemento.src =
            "/imagens/" +
            nomeArquivo;

        elemento.dataset.foto =
            nomeArquivo;

    }

}


/* ==================================================
   PARTE 11 - DESTAQUE DO VENCEDOR
================================================== */

function atualizarVencedor(
    estado
) {

    const jogador1 =
        document.getElementById(
            "ladoJogador1"
        );


    const jogador2 =
        document.getElementById(
            "ladoJogador2"
        );


    /*
       PRIMEIRO LIMPA QUALQUER
       DESTAQUE ANTERIOR
    */

    jogador1.classList.remove(
        "vencedor",
        "perdedor"
    );


    jogador2.classList.remove(
        "vencedor",
        "perdedor"
    );


    /*
       NENHUM ESCOLHIDO
    */

    if (
        estado.ladoVencedor !== 1 &&
        estado.ladoVencedor !== 2
    ) {

        return;

    }


    /*
       JOGADOR 1 ESCOLHIDO
    */

    if (
        estado.ladoVencedor === 1
    ) {

        jogador1.classList.add(
            "vencedor"
        );


        jogador2.classList.add(
            "perdedor"
        );

    }


    /*
       JOGADOR 2 ESCOLHIDO
    */

    if (
        estado.ladoVencedor === 2
    ) {

        jogador2.classList.add(
            "vencedor"
        );


        jogador1.classList.add(
            "perdedor"
        );

    }

}


/* ==================================================
   MODO NORMAL / FINAL
================================================== */

function atualizarModo(
    estado
) {

    const comparacao =
        document.getElementById(
            "comparacao"
        );


    const campoPequeno =
        document.getElementById(
            "campo-container"
        );


    const telaFinal =
        document.getElementById(
            "telaFinal"
        );


    const rodape =
        document.getElementById(
            "rodape"
        );


    if (
        estado.modoFinal === true
    ) {

        comparacao.style.display =
            "none";


        campoPequeno.style.display =
            "none";


        rodape.style.display =
            "none";


        telaFinal.style.display =
            "block";


        document.getElementById(
            "timeFinal1"
        ).innerText =

            (
                estado.time1 ||
                "TIME 1"
            ).toUpperCase();


        document.getElementById(
            "timeFinal2"
        ).innerText =

            (
                estado.time2 ||
                "TIME 2"
            ).toUpperCase();


        document.getElementById(
            "numeroFinal1"
        ).innerText =

            estado.placar1 || 0;


        document.getElementById(
            "numeroFinal2"
        ).innerText =

            estado.placar2 || 0;

    }

    else {

        comparacao.style.display =
            "block";


        campoPequeno.style.display =
            "block";


        rodape.style.display =
            "block";


        telaFinal.style.display =
            "none";

    }

}


/* ==================================================
   ATUALIZAR OVERLAY
================================================== */

async function atualizarOverlay() {

    try {

        const resposta =
            await fetch(

                "/api/estado?tempo=" +
                Date.now()

            );


        const estado =
            await resposta.json();


        /* MODO */

        atualizarModo(
            estado
        );


        /* DESTAQUE DO ESCOLHIDO */

        atualizarVencedor(
            estado
        );


        /* POSIÇÃO */

        document.getElementById(
            "posicao"
        ).innerText =

            estado.posicao ||
            "GOLEIRO";


        /* NOMES */

        document.getElementById(
            "nomeJogador1"
        ).innerText =

            (
                estado.jogador1 ||
                "JOGADOR 1"
            ).toUpperCase();


        document.getElementById(
            "nomeJogador2"
        ).innerText =

            (
                estado.jogador2 ||
                "JOGADOR 2"
            ).toUpperCase();


        /* FOTOS */

        atualizarFoto(

            document.getElementById(
                "fotoJogador1"
            ),

            estado.foto1

        );


        atualizarFoto(

            document.getElementById(
                "fotoJogador2"
            ),

            estado.foto2

        );


        /* TIMES */

        document.getElementById(
            "nomeTime1"
        ).innerText =

            (
                estado.time1 ||
                "TIME 1"
            ).toUpperCase();


        document.getElementById(
            "nomeTime2"
        ).innerText =

            (
                estado.time2 ||
                "TIME 2"
            ).toUpperCase();


        /* PLACAR */

        document.getElementById(
            "placar1"
        ).innerText =

            estado.placar1 || 0;


        document.getElementById(
            "placar2"
        ).innerText =

            estado.placar2 || 0;


        /* CAMPOS */

        atualizarTimeIdeal(
            estado.timeIdeal || []
        );


        atualizarTimeIdealFinal(
            estado.timeIdeal || []
        );

    }

    catch (erro) {

        console.log(
            "Aguardando servidor..."
        );

    }

}


/* ==================================================
   CAMPO PEQUENO
================================================== */

function atualizarTimeIdeal(
    timeIdeal
) {

    const campo =
        document.getElementById(
            "campo"
        );


    campo
        .querySelectorAll(
            ".jogador-campo"
        )
        .forEach(

            jogador =>
                jogador.remove()

        );


    timeIdeal.forEach(

        (item, ordem) => {


            const jogador =
                document.createElement(
                    "div"
                );


            const posicaoCampo =

                item.indice !== undefined

                    ? item.indice

                    : ordem;


            jogador.className =

                "jogador-campo " +

                "pos-" +
                posicaoCampo +

                " " +

                (
                    item.lado === 1

                        ? "lado1"

                        : "lado2"
                );


            if (
                item.foto &&
                item.foto.trim() !== ""
            ) {

                const foto =
                    document.createElement(
                        "img"
                    );


                foto.src =
                    "/imagens/" +
                    item.foto;


                foto.className =
                    "foto-campo";


                foto.onerror =
                    function() {

                        this.style.display =
                            "none";

                    };


                jogador.appendChild(
                    foto
                );

            }


            const nome =
                document.createElement(
                    "div"
                );


            nome.className =
                "nome-campo";


            nome.innerText =

                (
                    item.nome ||
                    "JOGADOR"
                ).toUpperCase();


            jogador.appendChild(
                nome
            );


            campo.appendChild(
                jogador
            );

        }

    );

}


