<script>

const jogos = [

    {
        casa: "FLAMENGO",
        visitante: "VASCO"
    },

    {
        casa: "PALMEIRAS",
        visitante: "CORINTHIANS"
    },

    {
        casa: "FLUMINENSE",
        visitante: "BOTAFOGO"
    }

];

let jogoAtual = 0;


/* PREENCHE O JOGO ATUAL */

function carregarJogo() {

    const jogo = jogos[jogoAtual];

    document.getElementById("casa").value =
        jogo.casa;

    document.getElementById("visitante").value =
        jogo.visitante;

    /* limpa os placares para o próximo palpite */

    document.getElementById("p1casa").value = "";
    document.getElementById("p1fora").value = "";

    document.getElementById("p2casa").value = "";
    document.getElementById("p2fora").value = "";

}


/* PEGA OS DADOS DO PAINEL */

function dados() {

    return {

        nome1:
            document.getElementById("nome1").value,

        nome2:
            document.getElementById("nome2").value,

        casa:
            document.getElementById("casa").value,

        visitante:
            document.getElementById("visitante").value,

        p1casa:
            document.getElementById("p1casa").value,

        p1fora:
            document.getElementById("p1fora").value,

        p2casa:
            document.getElementById("p2casa").value,

        p2fora:
            document.getElementById("p2fora").value

    };

}


/* ENVIA PARA O SERVIDOR */

async function enviar(acao) {

    const pacote = {
        acao: acao,
        dados: dados()
    };

    try {

        const resposta = await fetch(
            "/api/comando",
            {
                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body:
                    JSON.stringify(pacote)
            }
        );

        const resultado =
            await resposta.json();

        if (!resultado.ok) {

            alert(
                "Erro ao enviar comando."
            );

        }

    } catch (erro) {

        alert(
            "Não foi possível comunicar com o servidor."
        );

        console.error(erro);

    }

}


/* BOTÕES */

function salvar() {

    enviar("atualizar");

}


function revelar1() {

    enviar("revelar1");

}


function revelar2() {

    enviar("revelar2");

}


/* PRÓXIMO JOGO */

async function proximo() {

    /* guarda/envia o jogo atual */

    await enviar("proximo");


    /* verifica se existe outro jogo */

    if (
        jogoAtual <
        jogos.length - 1
    ) {

        jogoAtual++;

        carregarJogo();

        /*
        envia o novo confronto
        para o OBS
        */

        await enviar("atualizar");

    }

    else {

        alert(
            "Último jogo da rodada!"
        );

    }

}


/* CARREGA O PRIMEIRO JOGO */

carregarJogo();

</script>
