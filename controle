<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">

<title>Controle - Bate-Bola</title>

<style>

body {
    margin: 0;
    background: #111820;
    color: white;
    font-family: Arial, Helvetica, sans-serif;
}

.painel {
    width: 700px;
    margin: 40px auto;
}

h1 {
    text-align: center;
}

.caixa {
    background: #1c2730;
    padding: 25px;
    border-radius: 15px;
    margin-top: 20px;
}

h2 {
    margin-top: 0;
}

label {
    display: block;
    margin-top: 15px;
    margin-bottom: 5px;
    color: #aaa;
}

input {
    width: 100%;
    padding: 12px;
    box-sizing: border-box;

    border: 1px solid #45525c;
    border-radius: 7px;

    background: #0e1419;
    color: white;

    font-size: 17px;
}

.placar {
    display: flex;
    align-items: center;
    gap: 10px;
}

.placar input {
    width: 80px;
    text-align: center;
    font-size: 24px;
    font-weight: bold;
}

.x {
    font-size: 24px;
}

button {
    margin-top: 15px;
    padding: 13px 18px;

    border: none;
    border-radius: 8px;

    font-size: 15px;
    font-weight: bold;

    cursor: pointer;
}

.salvar {
    width: 100%;
    background: #28a745;
    color: white;
}

.revelar {
    background: white;
    color: black;
    margin-right: 8px;
}

.proximo {
    width: 100%;
    background: #2675d8;
    color: white;
    margin-top: 25px;
}

</style>
</head>

<body>

<div class="painel">

<h1>⚽ BATE-BOLA DA RODADA</h1>

<div class="caixa">

<h2>Apresentadores</h2>

<label>Seu nome</label>
<input
    id="nome1"
    value="MTS">

<label>Nome do parceiro</label>
<input
    id="nome2"
    value="AMIGO">

</div>


<div class="caixa">

<h2>Confronto</h2>

<label>Time da casa</label>
<input
    id="casa"
    value="FLAMENGO">

<label>Time visitante</label>
<input
    id="visitante"
    value="VASCO">

</div>


<div class="caixa">

<h2>Palpite 1</h2>

<div class="placar">

<input
    id="p1casa"
    type="number"
    min="0"
    value="2">

<span class="x">×</span>

<input
    id="p1fora"
    type="number"
    min="0"
    value="1">

</div>

<button
    class="revelar"
    onclick="revelar1()">

REVELAR PALPITE 1

</button>

</div>


<div class="caixa">

<h2>Palpite 2</h2>

<div class="placar">

<input
    id="p2casa"
    type="number"
    min="0"
    value="1">

<span class="x">×</span>

<input
    id="p2fora"
    type="number"
    min="0"
    value="1">

</div>

<button
    class="revelar"
    onclick="revelar2()">

REVELAR PALPITE 2

</button>

</div>


<button
    class="salvar"
    onclick="salvar()">

ATUALIZAR CONFRONTO

</button>

<button
    class="proximo"
    onclick="proximo()">

PRÓXIMO JOGO ▶

</button>

</div>


<script>

function dados() {

    return {

        nome1:
            document.getElementById("nome1").value,

        nome2:
            document.getElementById("nome2").value,

        casa:
            document.getElementById("casa").value,

        visitante:
            document.getElementById("visitante").value,

        p1casa:
            document.getElementById("p1casa").value,

        p1fora:
            document.getElementById("p1fora").value,

        p2casa:
            document.getElementById("p2casa").value,

        p2fora:
            document.getElementById("p2fora").value

    };

}


function enviar(acao) {

    const pacote = {
        acao: acao,
        dados: dados(),
        momento: Date.now()
    };

    localStorage.setItem(
        "batebola",
        JSON.stringify(pacote)
    );

}


function salvar() {
    enviar("atualizar");
}


function revelar1() {
    enviar("revelar1");
}


function revelar2() {
    enviar("revelar2");
}


function proximo() {
    enviar("proximo");
}

</script>

</body>
</html>
