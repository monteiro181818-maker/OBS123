    )


estado = criar_estado_inicial()


# ==========================================
# SERVIDOR
# ==========================================

class Servidor11x11(SimpleHTTPRequestHandler):

    # ======================================
    # ENVIAR JSON
    # ======================================

    def enviar_json(self, dados, status=200):
        resposta = json.dumps(
            dados,
            ensure_ascii=False
        ).encode("utf-8")

        self.send_response(status)

        self.send_header(
            "Content-Type",
            "application/json; charset=utf-8"
        )

        self.send_header(
            "Content-Length",
            str(len(resposta))
        )

        self.send_header(
            "Cache-Control",
            "no-store"
        )

        self.end_headers()

        self.wfile.write(resposta)


    # ======================================
    # LER JSON
    # ======================================

    def ler_json(self):
        tamanho = int(
            self.headers.get(
                "Content-Length",
                0
            )
        )

        if tamanho > 25 * 1024 * 1024:
            raise ValueError(
                "Envio muito grande."
            )

        corpo = self.rfile.read(tamanho)

        if not corpo:
            return {}

        return json.loads(
            corpo.decode("utf-8")
        )


    # ======================================
    # GET
    # ======================================

    def do_GET(self):
        caminho = self.path.split("?")[0]

        # ESTADO
        if caminho == "/api/estado":
            self.enviar_json(estado)
            return

        # IMAGENS
        if caminho == "/api/imagens":
            try:
                imagens = listar_imagens()

                self.enviar_json({
                    "ok": True,
                    "total": len(imagens),
                    "imagens": imagens
                })

            except Exception as erro:
                self.enviar_json({
                    "ok": False,
                    "erro": str(erro)
                }, 500)

            return

        # 11x11 SALVOS
        if caminho == "/api/11x11-salvos":
            try:
                salvos = listar_11x11_salvos()

                self.enviar_json({
                    "ok": True,
                    "total": len(salvos),
                    "salvos": salvos
                })

            except Exception as erro:
                self.enviar_json({
                    "ok": False,
                    "erro": str(erro)
                }, 500)

            return

        super().do_GET()


    # ======================================
    # POST
    # ======================================

    def do_POST(self):
        global estado

        caminho = self.path.split("?")[0]

        print(
            "POST recebido:",
            caminho
        )

        # ==================================
        # ESTADO
        # ==================================

        if caminho == "/api/estado":
            try:
                novos_dados = self.ler_json()

                estado.update(novos_dados)

                self.enviar_json({
                    "ok": True,
                    "estado": estado
                })

            except Exception as erro:
                self.enviar_json({
                    "ok": False,
                    "erro": str(erro)
                }, 400)

            return


        # ==================================
        # UPLOAD DE IMAGEM
        # ==================================

        if caminho == "/api/upload-imagem":
            try:
                dados = self.ler_json()

                nome = dados.get(
                    "nome",
                    ""
                )

                conteudo = dados.get(
                    "conteudo",
                    ""
                )

                if not nome:
                    raise ValueError(
                        "Nome da imagem não informado."
                    )

                if not conteudo:
                    raise ValueError(
                        "Imagem não enviada."
                    )

                nome_salvo = salvar_imagem_base64(
                    nome,
                    conteudo
                )

                print(
                    "Imagem salva:",
                    nome_salvo
                )

                self.enviar_json({
                    "ok": True,
                    "mensagem": (
                        "Imagem adicionada com sucesso."
                    ),
                    "arquivo": nome_salvo,
                    "url": (
                        "/imagens/" +
                        nome_salvo
                    )
                })

            except Exception as erro:
                print(
                    "Erro no upload:",
                    erro
                )

                self.enviar_json({
                    "ok": False,
                    "erro": str(erro)
                }, 400)

            return


        # ==================================
        # SALVAR CONFRONTOS ATIVOS
        # ==================================

        if caminho == "/api/salvar-confrontos":
            try:
                dados = self.ler_json()

                confrontos = validar_confrontos(
                    dados
                )

                salvar_confrontos({
                    "confrontos": confrontos
                })

                estado = criar_estado_dos_confrontos(
                    confrontos
                )

                print(
                    "11x11 ativo atualizado."
                )

                self.enviar_json({
                    "ok": True,
                    "mensagem": (
                        "11x11 salvo e carregado "
                        "com sucesso."
                    ),
                    "estado": estado
                })

            except Exception as erro:
                print(
                    "Erro ao salvar confrontos:",
                    erro
                )

                self.enviar_json({
                    "ok": False,
                    "erro": str(erro)
                }, 400)

            return


        # ==================================
        # SALVAR 11x11 NA BIBLIOTECA
        # ==================================

        if caminho == "/api/salvar-11x11":
            try:
                dados = self.ler_json()

                nome = str(
                    dados.get(
                        "nome",
                        ""
                    )
                ).strip()

                confrontos = dados.get(
                    "confrontos",
                    []
                )

                resultado = salvar_11x11_biblioteca(
                    nome,
                    confrontos
                )

                print(
                    "11x11 salvo:",
                    resultado["nome"],
                    "-",
                    resultado["arquivo"]
                )

                self.enviar_json({
                    "ok": True,
                    "mensagem": (
                        "11x11 salvo na biblioteca."
                    ),
                    "nome": resultado["nome"],
                    "arquivo": resultado["arquivo"]
                })

            except Exception as erro:
                print(
                    "Erro ao salvar 11x11:",
                    erro
                )

                self.enviar_json({
                    "ok": False,
                    "erro": str(erro)
                }, 400)

            return

        # ==================================
        # EDITAR 11x11 SALVO
        # SOMENTE LÊ - NÃO ATIVA NO OBS
        # ==================================

        if caminho == "/api/editar-11x11":
            try:
                dados = self.ler_json()

                arquivo = str(
                    dados.get(
                        "arquivo",
                        ""
                    )
                ).strip()

                if not arquivo:
                    raise ValueError(
                        "Arquivo do 11x11 não informado."
                    )

                resultado = carregar_11x11_salvo(
                    arquivo
                )

                print(
                    "11x11 aberto para edição:",
                    resultado["nome"]
                )

                self.enviar_json({
                    "ok": True,
                    "mensagem": (
                        "11x11 aberto para edição."
                    ),
                    "nome": resultado["nome"],
                    "arquivo": arquivo,
                    "confrontos": resultado["confrontos"]
                })

            except Exception as erro:
                print(
                    "Erro ao abrir 11x11 para edição:",
                    erro
                )

                self.enviar_json({
                    "ok": False,
                    "erro": str(erro)
                }, 400)

            return


        # ==================================
        # CARREGAR 11x11 SALVO
        # ==================================

        if caminho == "/api/carregar-11x11":
            try:
                dados = self.ler_json()

                arquivo = str(
                    dados.get(
                        "arquivo",
                        ""
                    )
                ).strip()

                if not arquivo:
                    raise ValueError(
                        "Arquivo do 11x11 não informado."
                    )

                resultado = carregar_11x11_salvo(
                    arquivo
                )

                confrontos = resultado[
                    "confrontos"
                ]

                # Torna este confronto o ativo
                salvar_confrontos({
                    "confrontos": confrontos
                })

                # Reseta placar e escalação
                estado = criar_estado_dos_confrontos(
                    confrontos
                )

                print(
                    "11x11 carregado:",
                    resultado["nome"]
                )

                self.enviar_json({
                    "ok": True,
                    "mensagem": (
                        "11x11 carregado com sucesso."
                    ),
                    "nome": resultado["nome"],
                    "arquivo": arquivo,
                    "confrontos": confrontos,
                    "estado": estado
                })

            except Exception as erro:
                print(
                    "Erro ao carregar 11x11:",
                    erro
                )

                self.enviar_json({
                    "ok": False,
                    "erro": str(erro)
                }, 400)

            return


        # ==================================
        # EXCLUIR 11x11 SALVO
        # ==================================

        if caminho == "/api/excluir-11x11":
            try:
                dados = self.ler_json()

                arquivo = str(
                    dados.get(
                        "arquivo",
                        ""
                    )
                ).strip()

                if not arquivo:
                    raise ValueError(
                        "Arquivo do 11x11 não informado."
                    )

                excluir_11x11_salvo(
                    arquivo
                )

                print(
                    "11x11 excluído:",
                    arquivo
                )

                self.enviar_json({
                    "ok": True,
                    "mensagem": (
                        "11x11 excluído com sucesso."
                    ),
                    "arquivo": arquivo
                })

            except Exception as erro:
                print(
                    "Erro ao excluir 11x11:",
                    erro
                )

                self.enviar_json({
                    "ok": False,
                    "erro": str(erro)
                }, 400)

            return


        # ==================================
        # RESET
        # ==================================

        if caminho == "/api/reset":
            try:
                estado = criar_estado_inicial()

                self.enviar_json({
                    "ok": True,
                    "estado": estado
                })

            except Exception as erro:
                self.enviar_json({
                    "ok": False,
                    "erro": str(erro)
                }, 400)

            return


        # ==================================
        # ROTA NÃO ENCONTRADA
        # ==================================

        print(
            "ROTA NÃO ENCONTRADA:",
            caminho
        )

        self.enviar_json({
            "ok": False,
            "erro": "Rota não encontrada",
            "rota": caminho
        }, 404)


