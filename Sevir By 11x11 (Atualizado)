# ==========================================
# JSON
# ==========================================

def carregar_json(caminho):
    with open(caminho, "r", encoding="utf-8") as arquivo:
        return json.load(arquivo)


def salvar_json(caminho, dados):
    with open(caminho, "w", encoding="utf-8") as arquivo:
        json.dump(
            dados,
            arquivo,
            ensure_ascii=False,
            indent=2
        )


# ==========================================
# CONFRONTOS ATIVOS
# ==========================================

def carregar_confrontos():
    try:
        return carregar_json(ARQUIVO_CONFRONTOS)
    except Exception:
        return {"confrontos": []}


def validar_confrontos(dados):
    if not isinstance(dados, dict):
        raise ValueError("Formato do 11x11 inválido.")

    confrontos = dados.get("confrontos")

    if not isinstance(confrontos, list):
        raise ValueError("Lista de confrontos inválida.")

    if len(confrontos) != 11:
        raise ValueError(
            "O 11x11 precisa ter exatamente 11 posições."
        )

    for numero, confronto in enumerate(confrontos, start=1):

        if not isinstance(confronto, dict):
            raise ValueError(
                f"Posição {numero} inválida."
            )

        posicao = str(
            confronto.get("posicao", "")
        ).strip()

        if not posicao:
            raise ValueError(
                f"Posição {numero} sem nome."
            )

        jogador1 = confronto.get("jogador1")
        jogador2 = confronto.get("jogador2")

        if not isinstance(jogador1, dict):
            raise ValueError(
                f"Jogador 1 da posição {numero} inválido."
            )

        if not isinstance(jogador2, dict):
            raise ValueError(
                f"Jogador 2 da posição {numero} inválido."
            )

        nome1 = str(
            jogador1.get("nome", "")
        ).strip()

        nome2 = str(
            jogador2.get("nome", "")
        ).strip()

        if not nome1:
            raise ValueError(
                f"Falta o jogador 1 da posição {numero}."
            )

        if not nome2:
            raise ValueError(
                f"Falta o jogador 2 da posição {numero}."
            )

    return confrontos


def salvar_confrontos(dados):
    validar_confrontos(dados)
    salvar_json(ARQUIVO_CONFRONTOS, dados)


# ==========================================
# NORMALIZAÇÃO DE NOMES
# ==========================================

def normalizar_nome(texto):
    texto = str(texto).strip()

    texto = unicodedata.normalize(
        "NFKD",
        texto
    )

    texto = "".join(
        caractere
        for caractere in texto
        if not unicodedata.combining(caractere)
    )

    texto = texto.lower()

    texto = re.sub(
        r"\s+",
        "-",
        texto
    )

    texto = re.sub(
        r"[^a-z0-9_-]",
        "",
        texto
    )

    texto = re.sub(
        r"-+",
        "-",
        texto
    )

    return texto.strip("-_")


# ==========================================
# BIBLIOTECA DE 11x11
# ==========================================

def gerar_nome_arquivo_11x11(nome):
    nome_limpo = normalizar_nome(nome)

    if not nome_limpo:
        nome_limpo = "11x11"

    return nome_limpo + ".json"


def caminho_11x11_salvo(arquivo):
    arquivo = os.path.basename(str(arquivo))

    if not arquivo.lower().endswith(".json"):
        raise ValueError(
            "Arquivo de 11x11 inválido."
        )

    return os.path.join(
        PASTA_SALVOS,
        arquivo
    )


def listar_11x11_salvos():
    lista = []

    for arquivo in os.listdir(PASTA_SALVOS):

        if not arquivo.lower().endswith(".json"):
            continue

        caminho = os.path.join(
            PASTA_SALVOS,
            arquivo
        )

        if not os.path.isfile(caminho):
            continue

        try:
            dados = carregar_json(caminho)

            confrontos = dados.get(
                "confrontos",
                []
            )

            nome = str(
                dados.get("nome", "")
            ).strip()

            if not nome:
                nome = os.path.splitext(
                    arquivo
                )[0]

            time1 = ""
            time2 = ""

            if confrontos:
                primeiro = confrontos[0]

                time1 = str(
                    primeiro
                    .get("jogador1", {})
                    .get("time", "")
                )

                time2 = str(
                    primeiro
                    .get("jogador2", {})
                    .get("time", "")
                )

            lista.append({
                "nome": nome,
                "arquivo": arquivo,
                "time1": time1,
                "time2": time2
            })

        except Exception as erro:
            print(
                "Erro ao ler salvo:",
                arquivo,
                erro
            )

    lista.sort(
        key=lambda item: item["nome"].lower()
    )

    return lista


def salvar_11x11_biblioteca(nome, confrontos):
    nome = str(nome).strip()

    if not nome:
        raise ValueError(
            "Digite um nome para o 11x11."
        )

    validar_confrontos({
        "confrontos": confrontos
    })

    arquivo = gerar_nome_arquivo_11x11(nome)

    caminho = caminho_11x11_salvo(
        arquivo
    )

    dados = {
        "nome": nome,
        "confrontos": confrontos
    }

    salvar_json(
        caminho,
        dados
    )

    return {
        "nome": nome,
        "arquivo": arquivo
    }


def carregar_11x11_salvo(arquivo):
    caminho = caminho_11x11_salvo(
        arquivo
    )

    if not os.path.exists(caminho):
        raise ValueError(
            "11x11 salvo não encontrado."
        )

    dados = carregar_json(caminho)

    confrontos = validar_confrontos(
        dados
    )

    nome = str(
        dados.get("nome", "")
    ).strip()

    if not nome:
        nome = os.path.splitext(
            os.path.basename(caminho)
        )[0]

    return {
        "nome": nome,
        "confrontos": confrontos
    }


def excluir_11x11_salvo(arquivo):
    caminho = caminho_11x11_salvo(
        arquivo
    )

    if not os.path.exists(caminho):
        raise ValueError(
            "11x11 salvo não encontrado."
        )

    os.remove(caminho)


# ==========================================
# IMAGENS
# ==========================================

def listar_imagens():
    extensoes = (
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
    )

    imagens = []

    for nome in os.listdir(PASTA_IMAGENS):

        caminho = os.path.join(
            PASTA_IMAGENS,
            nome
        )

        if not os.path.isfile(caminho):
            continue

        if not nome.lower().endswith(extensoes):
            continue

        imagens.append(nome)

    imagens.sort(
        key=lambda nome: nome.lower()
    )

    return imagens


def limpar_nome_arquivo(nome):
    nome = os.path.basename(str(nome))

    nome_base, extensao = os.path.splitext(
        nome
    )

    extensao = extensao.lower()

    extensoes = (
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
    )

    if extensao not in extensoes:
        raise ValueError(
            "Formato de imagem não permitido."
        )

    nome_base = normalizar_nome(
        nome_base
    )

    if not nome_base:
        nome_base = "imagem"

    return nome_base + extensao


def nome_disponivel(nome):
    caminho = os.path.join(
        PASTA_IMAGENS,
        nome
    )

    if not os.path.exists(caminho):
        return nome

    base, extensao = os.path.splitext(nome)

    numero = 2

    while True:
        novo_nome = (
            f"{base}-{numero}{extensao}"
        )

        novo_caminho = os.path.join(
            PASTA_IMAGENS,
            novo_nome
        )

        if not os.path.exists(novo_caminho):
            return novo_nome

        numero += 1


def salvar_imagem_base64(nome, conteudo):
    nome = limpar_nome_arquivo(nome)
    nome = nome_disponivel(nome)

    if not isinstance(conteudo, str):
        raise ValueError(
            "Conteúdo da imagem inválido."
        )

    if "," in conteudo:
        cabecalho, conteudo = conteudo.split(
            ",",
            1
        )

        if "base64" not in cabecalho.lower():
            raise ValueError(
                "Formato da imagem inválido."
            )

    try:
        dados_imagem = base64.b64decode(
            conteudo,
            validate=True
        )
    except Exception:
        raise ValueError(
            "Não foi possível ler a imagem."
        )

    if not dados_imagem:
        raise ValueError(
            "A imagem está vazia."
        )

    limite = 15 * 1024 * 1024

    if len(dados_imagem) > limite:
        raise ValueError(
            "A imagem ultrapassa o limite de 15 MB."
        )

    caminho = os.path.join(
        PASTA_IMAGENS,
        nome
    )

    with open(caminho, "wb") as arquivo:
        arquivo.write(dados_imagem)

    return nome


