<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<title>Controle - Bate-Bola</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #111820;
    color: white;
    font-family: Arial, Helvetica, sans-serif;
}

.painel {
    width: 820px;
    margin: 40px auto 100px;
}

h1 {
    text-align: center;
}

.caixa {
    background: #1c2730;
    padding: 25px;
    border-radius: 15px;
    margin-top: 20px;
}

h2 {
    margin-top: 0;
}

label {
    display: block;
    margin-top: 15px;
    margin-bottom: 5px;
    color: #aaa;
}

input,
select {
    width: 100%;
    padding: 12px;

    border: 1px solid #45525c;
    border-radius: 7px;

    background: #0e1419;
    color: white;

    font-size: 17px;
}

select {
    cursor: pointer;
}

input[readonly] {
    background: #182027;
    color: #d7e0e6;
    cursor: default;
}

/* =========================
   LISTA DE JOGOS
========================= */

.jogoConfig {
    display: grid;

    grid-template-columns:
        55px
        minmax(0, 1fr)
        35px
        minmax(0, 1fr)
        45px;

    gap: 10px;
    align-items: center;

    margin-top: 12px;
}

.numeroJogo {
    text-align: center;
    font-weight: bold;
    color: #8ea0ad;
}

.versus {
    text-align: center;
    font-size: 20px;
    font-weight: bold;
}

.remover {
    margin: 0;
    padding: 10px;

    background: #b92d3a;
    color: white;

    font-size: 17px;
}

.adicionar {
    width: 100%;
    margin-top: 20px;

    background: #555f68;
    color: white;
}

/* =========================
   JOGO ATUAL
========================= */

.statusJogo {
    text-align: center;

    padding: 10px;
    margin-bottom: 20px;

    background: #111820;
    border-radius: 8px;

    color: #9dacb7;
    font-weight: bold;
}

.confrontoAtual {
    display: grid;

    grid-template-columns:
        1fr 50px 1fr;

    gap: 10px;
    align-items: end;
}

.timeAtual label {
    margin-top: 0;
}

.xAtual {
    text-align: center;
    font-size: 27px;
    font-weight: bold;

    padding-bottom: 10px;
}

/* =========================
   PLACARES
========================= */

.placar {
    display: flex;
    align-items: center;
    gap: 10px;
}

.placar input {
    width: 80px;

    text-align: center;

    font-size: 24px;
    font-weight: bold;
}

.x {
    font-size: 24px;
}

/* =========================
   BOTÕES
========================= */

button {
    margin-top: 15px;
    padding: 13px 18px;

    border: none;
    border-radius: 8px;

    font-size: 15px;
    font-weight: bold;

    cursor: pointer;
}

button:hover {
    filter: brightness(1.1);
}

.iniciar {
    width: 100%;

    background: #6f42c1;
    color: white;
}

.salvar {
    width: 100%;

    background: #28a745;
    color: white;
}

.revelar {
    background: white;
    color: black;

    margin-right: 8px;
}

.proximo {
    width: 100%;

    background: #2675d8;
    color: white;

    margin-top: 25px;
}

.finalizar {
    width: 100%;

    background: #d58b19;
    color: white;

    margin-top: 15px;
}

.novaRodada {
    width: 100%;

    background: #b92d3a;
    color: white;

    margin-top: 15px;
}

.avisoSalvo {
    margin-top: 15px;

    text-align: center;

    color: #7fcf96;

    font-size: 14px;

    opacity: 0;
    transition: opacity .3s;
}

.avisoSalvo.visivel {
    opacity: 1;
}

</style>
</head>


<body>

<div class="painel">

<h1>⚽ BATE-BOLA DA RODADA</h1>


<!-- =========================
     APRESENTADORES
========================= -->

<div class="caixa">

<h2>Apresentadores</h2>

<label>Seu nome</label>

<input
    id="nome1"
    value="MATHEUS"
    oninput="mudouPainel()"
>

<label>Nome do parceiro</label>

<input
    id="nome2"
    value="THALYSON"
    oninput="mudouPainel()"
>

</div>


<!-- =========================
     JOGOS DA RODADA
========================= -->

<div class="caixa">

<h2>Jogos da rodada</h2>

<p style="color:#9dacb7;">
Escolha os confrontos antes de iniciar a rodada.
</p>

<div id="listaJogos"></div>


<button
    class="adicionar"
    onclick="adicionarJogo()"
>
+ ADICIONAR CONFRONTO
</button>


<button
    class="iniciar"
    onclick="iniciarRodada()"
>
INICIAR / CARREGAR RODADA
</button>

<div
    class="avisoSalvo"
    id="avisoSalvo"
>
Rodada salva automaticamente ✓
</div>

</div>


<!-- =========================
     CONFRONTO ATUAL
========================= -->

<div class="caixa">

<h2>Confronto atual</h2>


<div
    class="statusJogo"
    id="statusJogo"
>
JOGO 1
</div>


<div class="confrontoAtual">

<div class="timeAtual">

<label>Mandante</label>

<input
    id="casa"
    readonly
>

</div>


<div class="xAtual">
×
</div>


<div class="timeAtual">

<label>Visitante</label>

<input
    id="visitante"
    readonly
>

</div>

</div>

</div>


<!-- =========================
     PALPITE MATHEUS
========================= -->

<div class="caixa">

<h2 id="tituloPalpite1">
Palpite - MATHEUS
</h2>


<div class="placar">

<input
    id="p1casa"
    type="number"
    min="0"
    oninput="salvarEstado()"
>

<span class="x">
×
</span>

<input
    id="p1fora"
    type="number"
    min="0"
    oninput="salvarEstado()"
>

</div>


<button
    class="revelar"
    onclick="revelar1()"
>
REVELAR PALPITE MATHEUS
</button>

</div>


<!-- =========================
     PALPITE THALYSON
========================= -->

<div class="caixa">

<h2 id="tituloPalpite2">
Palpite - THALYSON
</h2>


<div class="placar">

<input
    id="p2casa"
    type="number"
    min="0"
    oninput="salvarEstado()"
>

<span class="x">
×
</span>

<input
    id="p2fora"
    type="number"
    min="0"
    oninput="salvarEstado()"
>

</div>


<button
    class="revelar"
    onclick="revelar2()"
>
REVELAR PALPITE THALYSON
</button>

</div>


<button
    class="salvar"
    onclick="salvar()"
>
ATUALIZAR CONFRONTO
</button>


<button
    class="proximo"
    onclick="proximo()"
>
PRÓXIMO JOGO ▶
</button>


<button
    class="finalizar"
    onclick="finalizar()"
>
FINALIZAR RODADA
</button>


<button
    class="novaRodada"
    onclick="novaRodada()"
>
NOVA RODADA
</button>


</div>


<script>

/* =========================
   CONFIGURAÇÃO
========================= */

const CHAVE_SALVAMENTO =
    "metreacts_batebola_estado_v1";


/* =========================
   20 CLUBES
========================= */

const clubes = [

    "ATHLETICO-PR",
    "ATLÉTICO-MG",
    "BAHIA",
    "BOTAFOGO",
    "CHAPECOENSE",
    "CORINTHIANS",
    "CORITIBA",
    "CRUZEIRO",
    "FLAMENGO",
    "FLUMINENSE",
    "GRÊMIO",
    "INTERNACIONAL",
    "MIRASSOL",
    "PALMEIRAS",
    "RED BULL BRAGANTINO",
    "REMO",
    "SANTOS",
    "SÃO PAULO",
    "VASCO",
    "VITÓRIA"

];


/* =========================
   JOGOS PADRÃO
========================= */

function jogosPadrao() {

    return [

        {
            casa: "FLAMENGO",
            visitante: "VASCO"
        },

        {
            casa: "PALMEIRAS",
            visitante: "CORINTHIANS"
        },

        {
            casa: "FLUMINENSE",
            visitante: "BOTAFOGO"
        }

    ];

}


let jogos =
    jogosPadrao();


let jogoAtual = 0;

let resultados = [];


/* =========================
   CRIA OPÇÕES
========================= */

function criarOpcoes(
    selecionado
) {

    let html =
        `<option value="">
            Selecione...
        </option>`;


    clubes.forEach(
        function(clube) {

            const marcado =
                clube === selecionado
                ? "selected"
                : "";


            html += `

                <option
                    value="${clube}"
                    ${marcado}
                >
                    ${clube}
                </option>

            `;

        }
    );


    return html;

}


/* =========================
   DESENHA JOGOS
========================= */

function desenharListaJogos() {

    const lista =
        document.getElementById(
            "listaJogos"
        );


    lista.innerHTML = "";


    jogos.forEach(
        function(jogo, indice) {

            const linha =
                document.createElement(
                    "div"
                );


            linha.className =
                "jogoConfig";


            linha.innerHTML = `

                <div class="numeroJogo">
                    ${indice + 1}
                </div>

                <select
                    id="configCasa${indice}"
                    onchange="mudouListaJogos()"
                >
                    ${criarOpcoes(
                        jogo.casa
                    )}
                </select>

                <div class="versus">
                    ×
                </div>

                <select
                    id="configVisitante${indice}"
                    onchange="mudouListaJogos()"
                >
                    ${criarOpcoes(
                        jogo.visitante
                    )}
                </select>

                <button
                    class="remover"
                    onclick="removerJogo(${indice})"
                    title="Remover confronto"
                >
                    ×
                </button>

            `;


            lista.appendChild(
                linha
            );

        }
    );

}


/* =========================
   LÊ JOGOS DA TELA
========================= */

function lerJogosDaTela() {

    const novosJogos = [];


    for (
        let i = 0;
        i < jogos.length;
        i++
    ) {

        const casa =
            document
                .getElementById(
                    "configCasa" + i
                )
                .value;


        const visitante =
            document
                .getElementById(
                    "configVisitante" + i
                )
                .value;


        novosJogos.push({

            casa: casa,

            visitante:
                visitante

        });

    }


    jogos =
        novosJogos;

}


/* =========================
   ALTERAÇÃO DA LISTA
========================= */

function mudouListaJogos() {

    lerJogosDaTela();

    salvarEstado();

}


/* =========================
   ADICIONAR JOGO
========================= */

function adicionarJogo() {

    lerJogosDaTela();


    jogos.push({

        casa: "",

        visitante: ""

    });


    desenharListaJogos();

    salvarEstado();

}


/* =========================
   REMOVER JOGO
========================= */

function removerJogo(indice) {

    if (
        jogos.length <= 1
    ) {

        alert(
            "A rodada precisa ter pelo menos um confronto."
        );

        return;

    }


    lerJogosDaTela();


    jogos.splice(
        indice,
        1
    );


    if (
        jogoAtual >=
        jogos.length
    ) {

        jogoAtual =
            jogos.length - 1;

    }


    desenharListaJogos();

    salvarEstado();

}


/* =========================
   VALIDA RODADA
========================= */

function validarRodada() {

    for (
        let i = 0;
        i < jogos.length;
        i++
    ) {

        if (
            !jogos[i].casa ||
            !jogos[i].visitante
        ) {

            alert(
                "Selecione mandante e visitante em todos os jogos."
            );

            return false;

        }


        if (
            jogos[i].casa ===
            jogos[i].visitante
        ) {

            alert(
                "O jogo " +
                (i + 1) +
                " está com o mesmo clube dos dois lados."
            );

            return false;

        }

    }


    return true;

}


/* =========================
   INICIAR RODADA
========================= */

async function iniciarRodada() {

    lerJogosDaTela();


    if (
        !validarRodada()
    ) {

        return;

    }


    jogoAtual = 0;

    resultados = [];


    carregarJogo(
        true
    );


    salvarEstado();


    await enviar(
        "atualizar"
    );

}


/* =========================
   CARREGA JOGO
========================= */

function carregarJogo(
    limparPalpites = true
) {

    const jogo =
        jogos[jogoAtual];


    if (!jogo) {
        return;
    }


    document
        .getElementById(
            "casa"
        )
        .value =
            jogo.casa;


    document
        .getElementById(
            "visitante"
        )
        .value =
            jogo.visitante;


    if (
        limparPalpites
    ) {

        document
            .getElementById(
                "p1casa"
            )
            .value = "";


        document
            .getElementById(
                "p1fora"
            )
            .value = "";


        document
            .getElementById(
                "p2casa"
            )
            .value = "";


        document
            .getElementById(
                "p2fora"
            )
            .value = "";

    }


    document
        .getElementById(
            "statusJogo"
        )
        .textContent =

            "JOGO " +
            (jogoAtual + 1) +
            " DE " +
            jogos.length;


    atualizarNomesPalpites();

}


/* =========================
   NOMES
========================= */

function mudouPainel() {

    atualizarNomesPalpites();

    salvarEstado();

}


function atualizarNomesPalpites() {

    const nome1 =
        document
            .getElementById(
                "nome1"
            )
            .value
            .trim()
            .toUpperCase() ||
            "MATHEUS";


    const nome2 =
        document
            .getElementById(
                "nome2"
            )
            .value
            .trim()
            .toUpperCase() ||
            "THALYSON";


    document
        .getElementById(
            "tituloPalpite1"
        )
        .textContent =
            "Palpite - " +
            nome1;


    document
        .getElementById(
            "tituloPalpite2"
        )
        .textContent =
            "Palpite - " +
            nome2;

}


/* =========================
   DADOS DO JOGO
========================= */

function dados() {

    return {

        nome1:
            document
                .getElementById(
                    "nome1"
                )
                .value
                .trim() ||
                "MATHEUS",

        nome2:
            document
                .getElementById(
                    "nome2"
                )
                .value
                .trim() ||
                "THALYSON",

        casa:
            document
                .getElementById(
                    "casa"
                )
                .value
                .trim(),

        visitante:
            document
                .getElementById(
                    "visitante"
                )
                .value
                .trim(),

        p1casa:
            document
                .getElementById(
                    "p1casa"
                )
                .value,

        p1fora:
            document
                .getElementById(
                    "p1fora"
                )
                .value,

        p2casa:
            document
                .getElementById(
                    "p2casa"
                )
                .value,

        p2fora:
            document
                .getElementById(
                    "p2fora"
                )
                .value

    };

}


/* =========================
   SALVAMENTO AUTOMÁTICO
========================= */

function salvarEstado() {

    try {

        const estado = {

            nome1:
                document
                    .getElementById(
                        "nome1"
                    )
                    .value,

            nome2:
                document
                    .getElementById(
                        "nome2"
                    )
                    .value,

            jogos:
                jogos,

            jogoAtual:
                jogoAtual,

            resultados:
                resultados,

            palpiteAtual: {

                p1casa:
                    document
                        .getElementById(
                            "p1casa"
                        )
                        .value,

                p1fora:
                    document
                        .getElementById(
                            "p1fora"
                        )
                        .value,

                p2casa:
                    document
                        .getElementById(
                            "p2casa"
                        )
                        .value,

                p2fora:
                    document
                        .getElementById(
                            "p2fora"
                        )
                        .value

            }

        };


        localStorage.setItem(

            CHAVE_SALVAMENTO,

            JSON.stringify(
                estado
            )

        );


        mostrarAvisoSalvo();


    } catch (erro) {

        console.error(
            "Erro ao salvar rodada:",
            erro
        );

    }

}


/* =========================
   AVISO SALVO
========================= */

let temporizadorAviso;


function mostrarAvisoSalvo() {

    const aviso =
        document.getElementById(
            "avisoSalvo"
        );


    aviso.classList.add(
        "visivel"
    );


    clearTimeout(
        temporizadorAviso
    );


    temporizadorAviso =
        setTimeout(
            function() {

                aviso
                    .classList
                    .remove(
                        "visivel"
                    );

            },
            1200
        );

}


/* =========================
   RECUPERA ESTADO
========================= */

function recuperarEstado() {

    try {

        const salvo =
            localStorage.getItem(
                CHAVE_SALVAMENTO
            );


        if (!salvo) {

            return false;

        }


        const estado =
            JSON.parse(
                salvo
            );


        if (
            Array.isArray(
                estado.jogos
            ) &&
            estado.jogos.length > 0
        ) {

            jogos =
                estado.jogos;

        }


        if (
            Array.isArray(
                estado.resultados
            )
        ) {

            resultados =
                estado.resultados;

        }


        if (
            Number.isInteger(
                estado.jogoAtual
            )
        ) {

            jogoAtual =
                estado.jogoAtual;

        }


        if (
            jogoAtual < 0 ||
            jogoAtual >= jogos.length
        ) {

            jogoAtual = 0;

        }


        document
            .getElementById(
                "nome1"
            )
            .value =
                estado.nome1 ||
                "MATHEUS";


        document
            .getElementById(
                "nome2"
            )
            .value =
                estado.nome2 ||
                "THALYSON";


        desenharListaJogos();


        carregarJogo(
            true
        );


        if (
            estado.palpiteAtual
        ) {

            document
                .getElementById(
                    "p1casa"
                )
                .value =
                    estado
                    .palpiteAtual
                    .p1casa || "";


            document
                .getElementById(
                    "p1fora"
                )
                .value =
                    estado
                    .palpiteAtual
                    .p1fora || "";


            document
                .getElementById(
                    "p2casa"
                )
                .value =
                    estado
                    .palpiteAtual
                    .p2casa || "";


            document
                .getElementById(
                    "p2fora"
                )
                .value =
                    estado
                    .palpiteAtual
                    .p2fora || "";

        }


        atualizarNomesPalpites();


        return true;


    } catch (erro) {

        console.error(
            "Erro ao recuperar rodada:",
            erro
        );


        return false;

    }

}


/* =========================
   ENVIA AO SERVIDOR
========================= */

async function enviar(acao) {

    const pacote = {

        acao:
            acao,

        dados:
            dados(),

        resultados:
            resultados

    };


    try {

        const resposta =
            await fetch(

                "/api/comando",

                {
                    method:
                        "POST",

                    headers: {

                        "Content-Type":
                            "application/json"

                    },

                    body:
                        JSON.stringify(
                            pacote
                        )
                }

            );


        const resultado =
            await resposta.json();


        if (
            !resultado.ok
        ) {

            alert(
                "Erro ao enviar comando."
            );

        }


    } catch (erro) {

        alert(
            "Não foi possível comunicar com o servidor."
        );


        console.error(
            erro
        );

    }

}


/* =========================
   COMANDOS
========================= */

function salvar() {

    salvarEstado();

    enviar(
        "atualizar"
    );

}


function revelar1() {

    salvarEstado();

    enviar(
        "revelar1"
    );

}


function revelar2() {

    salvarEstado();

    enviar(
        "revelar2"
    );

}


/* =========================
   GUARDA RESULTADO
========================= */

function guardarResultadoAtual() {

    const d =
        dados();


    resultados[jogoAtual] = {

        casa:
            d.casa,

        visitante:
            d.visitante,

        nome1:
            d.nome1,

        nome2:
            d.nome2,

        palpite1:
            d.p1casa +
            " × " +
            d.p1fora,

        palpite2:
            d.p2casa +
            " × " +
            d.p2fora

    };


    salvarEstado();

}


/* =========================
   VALIDA PALPITES
========================= */

function palpitesPreenchidos() {

    const d =
        dados();


    return !(

        d.p1casa === "" ||

        d.p1fora === "" ||

        d.p2casa === "" ||

        d.p2fora === ""

    );

}


/* =========================
   PRÓXIMO
========================= */

async function proximo() {

    if (
        !palpitesPreenchidos()
    ) {

        alert(
            "Preencha os dois palpites antes de continuar."
        );

        return;

    }


    guardarResultadoAtual();


    await enviar(
        "proximo"
    );


    if (
        jogoAtual <
        jogos.length - 1
    ) {

        jogoAtual++;


        carregarJogo(
            true
        );


        salvarEstado();


        await enviar(
            "atualizar"
        );

    }

    else {

        alert(
            "Este é o último jogo. Clique em FINALIZAR RODADA para mostrar o quadro final."
        );

    }

}


/* =========================
   FINALIZAR
========================= */

async function finalizar() {

    if (
        !palpitesPreenchidos()
    ) {

        alert(
            "Preencha os dois palpites antes de finalizar."
        );

        return;

    }


    guardarResultadoAtual();


    salvarEstado();


    await enviar(
        "finalizar"
    );

}


/* =========================
   NOVA RODADA
========================= */

async function novaRodada() {

    const confirmar =
        confirm(
            "Deseja realmente iniciar uma NOVA RODADA? Os confrontos e palpites salvos serão apagados."
        );


    if (
        !confirmar
    ) {

        return;

    }


    localStorage.removeItem(
        CHAVE_SALVAMENTO
    );


    jogos =
        jogosPadrao();


    jogoAtual = 0;

    resultados = [];


    document
        .getElementById(
            "nome1"
        )
        .value =
            "MATHEUS";


    document
        .getElementById(
