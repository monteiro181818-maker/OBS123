<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<title>Painel 11x11 Metreacts</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 30px;
    background: #090a10;
    color: white;
    font-family: Arial, sans-serif;
}

.painel {
    width: 900px;
    margin: auto;
    background: #11131c;
    border: 2px solid #633cff;
    border-radius: 18px;
    padding: 30px;
    box-shadow: 0 0 30px rgba(99,60,255,0.30);
}

h1 {
    margin-top: 0;
    text-align: center;
    font-size: 32px;
}

.posicao {
    margin-top: 25px;
    margin-bottom: 30px;
    text-align: center;
}

.posicao-numero {
    color: #9b82ff;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 8px;
}

#posicaoAtual {
    font-size: 30px;
    font-weight: 900;
}

.comparacao {
    display: flex;
    gap: 25px;
}

.jogador {
    flex: 1;
    background: #181b26;
    border: 1px solid #303443;
    border-radius: 14px;
    padding: 22px;
}

.jogador1 {
    border-top: 4px solid #168cff;
}

.jogador2 {
    border-top: 4px solid #ad24ff;
}

label {
    display: block;
    margin-bottom: 8px;
    color: #aeb3c2;
    font-size: 14px;
    font-weight: bold;
}

input {
    width: 100%;
    height: 46px;
    padding: 0 14px;
    margin-bottom: 15px;
    background: #0d0f16;
    color: white;
    border: 1px solid #363a49;
    border-radius: 8px;
    font-size: 17px;
    outline: none;
}

input:focus {
    border-color: #704cff;
}

.escolher {
    width: 100%;
    height: 50px;
    margin-top: 5px;
    border: none;
    border-radius: 9px;
    color: white;
    font-size: 17px;
    font-weight: 900;
    cursor: pointer;
}

.escolher1 {
    background: #1677d2;
}

.escolher2 {
    background: #8d2ee0;
}

.escolher:hover {
    filter: brightness(1.15);
}

#vencedor {
    margin-top: 25px;
    min-height: 55px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d0f16;
    border-radius: 10px;
    font-size: 19px;
    font-weight: bold;
    color: #b8bdca;
}

#vencedor.escolhido {
    color: white;
    border: 1px solid #633cff;
}

.navegacao {
    margin-top: 25px;
    display: flex;
    gap: 15px;
}

.navegacao button {
    flex: 1;
    height: 52px;
    background: #252938;
    color: white;
    border: 1px solid #3b4052;
    border-radius: 9px;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
}

#proximo {
    background: #633cff;
    border-color: #795cff;
}

.reset-area {
    margin-top: 25px;
    padding-top: 25px;
    border-top: 1px solid #2d3140;
}

#resetar {
    width: 100%;
    height: 52px;
    background: #9e2633;
    color: white;
    border: 1px solid #d23a4a;
    border-radius: 9px;
    font-size: 17px;
    font-weight: 900;
    cursor: pointer;
}

#resetar:hover {
    background: #ba2d3d;
}

#statusServidor {
    margin-top: 20px;
    text-align: center;
    font-size: 13px;
    font-weight: bold;
    color: #6cff9d;
}

</style>
</head>

<body>

<div class="painel">

    <h1>PAINEL 11x11</h1>

    <div class="posicao">

        <div
            class="posicao-numero"
            id="numeroPosicao">
            1 / 11
        </div>

        <div id="posicaoAtual">
            GOLEIRO
        </div>

    </div>


    <div class="comparacao">


        <!-- JOGADOR 1 -->

        <div class="jogador jogador1">

            <label>JOGADOR 1</label>

            <input
                type="text"
                id="jogador1"
                value="Verbruggen"
            >

            <label>TIME / SELEÇÃO</label>

            <input
                type="text"
                id="time1"
                value="Holanda"
            >

            <label>ARQUIVO DA FOTO</label>

            <input
                type="text"
                id="foto1"
                value="verbruggen.png"
                placeholder="exemplo.png"
            >

            <button
                class="escolher escolher1"
                onclick="escolherJogador(1)">
                ESCOLHER VERBRUGGEN
            </button>

        </div>


        <!-- JOGADOR 2 -->

        <div class="jogador jogador2">

            <label>JOGADOR 2</label>

            <input
                type="text"
                id="jogador2"
                value="Ter Stegen"
            >

            <label>TIME / SELEÇÃO</label>

            <input
                type="text"
                id="time2"
                value="Alemanha"
            >

            <label>ARQUIVO DA FOTO</label>

            <input
                type="text"
                id="foto2"
                value="ter-stegen.png"
                placeholder="exemplo.png"
            >

            <button
                class="escolher escolher2"
                onclick="escolherJogador(2)">
                ESCOLHER TER STEGEN
            </button>

        </div>

    </div>


    <div id="vencedor">
        Nenhum jogador escolhido
    </div>


    <div class="navegacao">

        <button onclick="anterior()">
            ← ANTERIOR
        </button>

        <button
            id="proximo"
            onclick="proximo()">
            PRÓXIMO →
        </button>

    </div>


    <div class="reset-area">

        <button
            id="resetar"
            onclick="resetar11x11()">
            RESETAR 11x11
        </button>

    </div>


    <div id="statusServidor">
        SERVIDOR CONECTADO
    </div>

</div>


<script>

/* =========================================
   POSIÇÕES
========================================= */

const posicoes = [
    "GOLEIRO",
    "LATERAL DIREITO",
    "ZAGUEIRO 1",
    "ZAGUEIRO 2",
    "LATERAL ESQUERDO",
    "VOLANTE",
    "MEIA 1",
    "MEIA 2",
    "PONTA DIREITA",
    "CENTROAVANTE",
    "PONTA ESQUERDA"
];

let indice = 0;

let placar1 = 0;
let placar2 = 0;

let timeIdeal = [];


/* =========================================
   POST
========================================= */

async function enviarEstado(dados) {

    try {

        const resposta = await fetch(
            "/api/estado",
            {
                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify(dados)
            }
        );

        const resultado =
            await resposta.json();

        if (resultado.ok) {

            statusServidor(
                "SERVIDOR CONECTADO",
                "#6cff9d"
            );

        }

    }

    catch (erro) {

        statusServidor(
            "ERRO DE CONEXÃO",
            "#ff5c5c"
        );

        console.error(erro);

    }

}


/* =========================================
   STATUS
========================================= */

function statusServidor(texto, cor) {

    const status =
        document.getElementById(
            "statusServidor"
        );

    status.innerText = texto;
    status.style.color = cor;

}


/* =========================================
   PEGAR DADOS DOS CAMPOS
========================================= */

function pegarDadosJogadores() {

    return {

        jogador1:
            document.getElementById(
                "jogador1"
            ).value.trim(),

        time1:
            document.getElementById(
                "time1"
            ).value.trim(),

        foto1:
            document.getElementById(
                "foto1"
            ).value.trim(),

        jogador2:
            document.getElementById(
                "jogador2"
            ).value.trim(),

        time2:
            document.getElementById(
                "time2"
            ).value.trim(),

        foto2:
            document.getElementById(
                "foto2"
            ).value.trim()

    };

}


/* =========================================
   ENVIAR JOGADORES
========================================= */

function enviarJogadores() {

    enviarEstado(
        pegarDadosJogadores()
    );

}


/* =========================================
   ATUALIZAR BOTÕES
========================================= */

function atualizarBotoes() {

    const nome1 =
        document.getElementById(
            "jogador1"
        ).value;

    const nome2 =
        document.getElementById(
            "jogador2"
        ).value;


    document.querySelector(
        ".escolher1"
    ).innerText =
        "ESCOLHER " +
        nome1.toUpperCase();


    document.querySelector(
        ".escolher2"
    ).innerText =
        "ESCOLHER " +
        nome2.toUpperCase();

}


/* =========================================
   POSIÇÃO
========================================= */

function atualizarPosicao() {

    document.getElementById(
        "numeroPosicao"
    ).innerText =
        (indice + 1) +
        " / " +
        posicoes.length;


    document.getElementById(
        "posicaoAtual"
    ).innerText =
        posicoes[indice];


    enviarEstado({

        posicao:
            posicoes[indice],

        numeroPosicao:
            indice + 1

    });

}


/* =========================================
   ESCOLHER JOGADOR
========================================= */

function escolherJogador(lado) {

    const dados =
        pegarDadosJogadores();


    let jogadorEscolhido;
    let timeEscolhido;
    let fotoEscolhida;


    if (lado === 1) {

        jogadorEscolhido =
            dados.jogador1;

        timeEscolhido =
            dados.time1;

        fotoEscolhida =
            dados.foto1;

    }

    else {

        jogadorEscolhido =
            dados.jogador2;

        timeEscolhido =
            dados.time2;

        fotoEscolhida =
            dados.foto2;

    }


    /*
       Se já existe vencedor nessa posição,
       remove antes de salvar novamente.
    */

    const existente =
        timeIdeal.find(
            item =>
                item.posicao ===
                posicoes[indice]
        );


    /*
       Se não havia vencedor,
       soma o ponto.
    */

    if (!existente) {

        if (lado === 1) {

            placar1++;

        }

        else {

            placar2++;

        }

    }

    else {

        /*
           Se trocou o vencedor de lado,
           corrige o placar.
        */

        if (
            existente.lado !== lado
        ) {

            if (
                existente.lado === 1
            ) {

                placar1--;
                placar2++;

            }

            else {

                placar2--;
                placar1++;

            }

        }

    }


    timeIdeal =
        timeIdeal.filter(
            item =>
                item.posicao !==
                posicoes[indice]
        );


    timeIdeal.push({

        posicao:
            posicoes[indice],

        jogador:
            jogadorEscolhido,

        time:
            timeEscolhido,

        foto:
            fotoEscolhida,

        lado:
            lado,

        indice:
            indice

    });


    const vencedor =
        document.getElementById(
            "vencedor"
        );


    vencedor.innerText =
        "ESCOLHIDO: " +
        jogadorEscolhido.toUpperCase() +
        " — " +
        timeEscolhido.toUpperCase();


    vencedor.classList.add(
        "escolhido"
    );


    enviarEstado({

        ...dados,

        posicao:
            posicoes[indice],

        numeroPosicao:
            indice + 1,

        vencedor:
            jogadorEscolhido,

        ladoVencedor:
            lado,

        placar1:
            placar1,

        placar2:
            placar2,

        timeIdeal:
            timeIdeal

    });

}


/* =========================================
   PRÓXIMO
========================================= */

function proximo() {

    if (
        indice <
        posicoes.length - 1
    ) {

        indice++;

        atualizarPosicao();

        limparVencedor();

    }

}


/* =========================================
   ANTERIOR
========================================= */

function anterior() {

    if (indice > 0) {

        indice--;

        atualizarPosicao();

        limparVencedor();

    }

}


/* =========================================
   LIMPAR VENCEDOR VISUAL
========================================= */

function limparVencedor() {

    const vencedor =
        document.getElementById(
            "vencedor"
        );

    vencedor.innerText =
        "Nenhum jogador escolhido";

    vencedor.classList.remove(
        "escolhido"
    );

}


/* =========================================
   RESET
========================================= */

async function resetar11x11() {

    const confirmar =
        confirm(
            "Deseja realmente resetar o 11x11?"
        );


    if (!confirmar) {

        return;

    }


    try {

        const resposta =
            await fetch(
                "/api/reset",
                {
                    method: "POST"
                }
            );


        const resultado =
            await resposta.json();


        if (resultado.ok) {

            indice = 0;

            placar1 = 0;
            placar2 = 0;

            timeIdeal = [];


            carregarEstado();


            limparVencedor();


            statusServidor(
                "11x11 RESETADO",
                "#6cff9d"
            );

        }

    }

    catch (erro) {

        statusServidor(
            "ERRO AO RESETAR",
            "#ff5c5c"
        );

    }

}


/* =========================================
   CARREGAR ESTADO
========================================= */

async function carregarEstado() {

    try {

        const resposta =
            await fetch(
                "/api/estado?tempo=" +
                Date.now()
            );


        const estado =
            await resposta.json();


        document.getElementById(
            "jogador1"
        ).value =
            estado.jogador1 || "";


        document.getElementById(
            "time1"
        ).value =
            estado.time1 || "";


        document.getElementById(
            "foto1"
        ).value =
            estado.foto1 || "";


        document.getElementById(
            "jogador2"
        ).value =
            estado.jogador2 || "";


        document.getElementById(
            "time2"
        ).value =
            estado.time2 || "";


        document.getElementById(
            "foto2"
        ).value =
            estado.foto2 || "";


        indice =
            Math.max(
                0,
                (estado.numeroPosicao || 1)
                - 1
            );


        placar1 =
            estado.placar1 || 0;


        placar2 =
            estado.placar2 || 0;


        timeIdeal =
            estado.timeIdeal || [];


        document.getElementById(
            "numeroPosicao"
        ).innerText =
            (indice + 1) +
            " / " +
            posicoes.length;


        document.getElementById(
            "posicaoAtual"
        ).innerText =
            posicoes[indice];


        atualizarBotoes();


        statusServidor(
            "SERVIDOR CONECTADO",
            "#6cff9d"
        );

    }

    catch (erro) {

        statusServidor(
            "ERRO DE CONEXÃO",
            "#ff5c5c"
        );

    }

}


/* =========================================
   EVENTOS
========================================= */

[
    "jogador1",
    "time1",
    "foto1",
    "jogador2",
    "time2",
    "foto2"

].forEach(id => {

    document
        .getElementById(id)
        .addEventListener(
            "input",
            function() {

                atualizarBotoes();

                enviarJogadores();

            }
        );

});


/* =========================================
   INICIAR
========================================= */

carregarEstado();

</script>

</body>

</html>
