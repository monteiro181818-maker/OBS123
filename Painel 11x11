<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<title>Painel 11x11 Metreacts</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 30px;
    background: #090a10;
    color: white;
    font-family: Arial, sans-serif;
}

.painel {
    width: 900px;
    margin: auto;
    background: #11131c;
    border: 2px solid #633cff;
    border-radius: 18px;
    padding: 30px;
    box-shadow: 0 0 30px rgba(99,60,255,0.30);
}

h1 {
    margin-top: 0;
    text-align: center;
    font-size: 32px;
}

.posicao {
    margin-top: 25px;
    margin-bottom: 30px;
    text-align: center;
}

.posicao-numero {
    color: #9b82ff;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 8px;
}

#posicaoAtual {
    font-size: 30px;
    font-weight: 900;
}

.comparacao {
    display: flex;
    gap: 25px;
}

.jogador {
    flex: 1;
    background: #181b26;
    border: 1px solid #303443;
    border-radius: 14px;
    padding: 22px;
}

.jogador1 {
    border-top: 4px solid #168cff;
}

.jogador2 {
    border-top: 4px solid #ad24ff;
}

label {
    display: block;
    margin-bottom: 8px;
    color: #aeb3c2;
    font-size: 14px;
    font-weight: bold;
}

input {
    width: 100%;
    height: 46px;
    padding: 0 14px;
    margin-bottom: 15px;
    background: #0d0f16;
    color: white;
    border: 1px solid #363a49;
    border-radius: 8px;
    font-size: 17px;
    outline: none;
}

input:focus {
    border-color: #704cff;
}

.escolher {
    width: 100%;
    height: 50px;
    margin-top: 5px;
    border: none;
    border-radius: 9px;
    color: white;
    font-size: 17px;
    font-weight: 900;
    cursor: pointer;
}

.escolher1 {
    background: #1677d2;
}

.escolher2 {
    background: #8d2ee0;
}

.escolher:hover {
    filter: brightness(1.15);
}

#vencedor {
    margin-top: 25px;
    min-height: 55px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d0f16;
    border-radius: 10px;
    font-size: 19px;
    font-weight: bold;
    color: #b8bdca;
}

#vencedor.escolhido {
    color: white;
    border: 1px solid #633cff;
}

.navegacao {
    margin-top: 25px;
    display: flex;
    gap: 15px;
}

.navegacao button {
    flex: 1;
    height: 52px;
    background: #252938;
    color: white;
    border: 1px solid #3b4052;
    border-radius: 9px;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
}

#proximo {
    background: #633cff;
    border-color: #795cff;
}

#proximo:hover {
    background: #7555ff;
}

.reset-area {
    margin-top: 25px;
    padding-top: 25px;
    border-top: 1px solid #2d3140;
}

#resetar {
    width: 100%;
    height: 52px;
    background: #9e2633;
    color: white;
    border: 1px solid #d23a4a;
    border-radius: 9px;
    font-size: 17px;
    font-weight: 900;
    cursor: pointer;
}

#resetar:hover {
    background: #ba2d3d;
}

#statusServidor {
    margin-top: 20px;
    text-align: center;
    font-size: 13px;
    font-weight: bold;
    color: #6cff9d;
}

</style>
</head>

<body>

<div class="painel">

    <h1>PAINEL 11x11</h1>

    <div class="posicao">

        <div
            class="posicao-numero"
            id="numeroPosicao">
            1 / 11
        </div>

        <div id="posicaoAtual">
            CARREGANDO...
        </div>

    </div>


    <div class="comparacao">


        <!-- JOGADOR 1 -->

        <div class="jogador jogador1">

            <label>JOGADOR 1</label>

            <input
                type="text"
                id="jogador1"
            >

            <label>TIME / SELEÇÃO</label>

            <input
                type="text"
                id="time1"
            >

            <label>ARQUIVO DA FOTO</label>

            <input
                type="text"
                id="foto1"
            >

            <button
                class="escolher escolher1"
                onclick="escolherJogador(1)">
                ESCOLHER
            </button>

        </div>


        <!-- JOGADOR 2 -->

        <div class="jogador jogador2">

            <label>JOGADOR 2</label>

            <input
                type="text"
                id="jogador2"
            >

            <label>TIME / SELEÇÃO</label>

            <input
                type="text"
                id="time2"
            >

            <label>ARQUIVO DA FOTO</label>

            <input
                type="text"
                id="foto2"
            >

            <button
                class="escolher escolher2"
                onclick="escolherJogador(2)">
                ESCOLHER
            </button>

        </div>

    </div>


    <div id="vencedor">
        Nenhum jogador escolhido
    </div>


    <div class="navegacao">

        <button onclick="anterior()">
            ← ANTERIOR
        </button>

        <button
            id="proximo"
            onclick="proximo()">
            PRÓXIMO →
        </button>

    </div>


    <div class="reset-area">

        <button
            id="resetar"
            onclick="resetar11x11()">
            RESETAR 11x11
        </button>

    </div>


    <div id="statusServidor">
        CARREGANDO...
    </div>

</div>


<script>

/* =========================================
   VARIÁVEIS
========================================= */

let confrontos = [];

let indice = 0;

let placar1 = 0;
let placar2 = 0;

let timeIdeal = [];


/* =========================================
   STATUS
========================================= */

function statusServidor(texto, cor) {

    const status =
        document.getElementById(
            "statusServidor"
        );

    status.innerText = texto;
    status.style.color = cor;

}


/* =========================================
   ENVIAR ESTADO
========================================= */

async function enviarEstado(dados) {

    try {

        const resposta =
            await fetch(
                "/api/estado",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify(dados)
                }
            );


        const resultado =
            await resposta.json();


        if (resultado.ok) {

            statusServidor(
                "SERVIDOR CONECTADO",
                "#6cff9d"
            );

        }

    }

    catch (erro) {

        statusServidor(
            "ERRO DE CONEXÃO",
            "#ff5c5c"
        );

        console.error(erro);

    }

}


/* =========================================
   CARREGAR JSON DOS CONFRONTOS
========================================= */

async function carregarConfrontos() {

    try {

        const resposta =
            await fetch(
                "/dados/confrontos.json?tempo=" +
                Date.now()
            );


        const dados =
            await resposta.json();


        confrontos =
            dados.confrontos || [];


        if (confrontos.length === 0) {

            throw new Error(
                "Nenhum confronto cadastrado."
            );

        }


        await carregarEstado();


        carregarConfronto(
            indice,
            false
        );


        statusServidor(
            "SERVIDOR CONECTADO",
            "#6cff9d"
        );

    }

    catch (erro) {

        console.error(erro);

        statusServidor(
            "ERRO AO CARREGAR CONFRONTOS",
            "#ff5c5c"
        );

    }

}


/* =========================================
   CARREGAR ESTADO ATUAL
========================================= */

async function carregarEstado() {

    try {

        const resposta =
            await fetch(
                "/api/estado?tempo=" +
                Date.now()
            );


        const estado =
            await resposta.json();


        indice =
            Math.max(
                0,
                (estado.numeroPosicao || 1)
                - 1
            );


        if (
            indice >= confrontos.length
        ) {

            indice = 0;

        }


        placar1 =
            estado.placar1 || 0;


        placar2 =
            estado.placar2 || 0;


        timeIdeal =
            estado.timeIdeal || [];

    }

    catch (erro) {

        console.error(erro);

        indice = 0;
        placar1 = 0;
        placar2 = 0;
        timeIdeal = [];

    }

}


/* =========================================
   CARREGAR UM CONFRONTO
========================================= */

function carregarConfronto(
    numero,
    enviar = true
) {

    const confronto =
        confrontos[numero];


    if (!confronto) {

        return;

    }


    /* POSIÇÃO */

    document.getElementById(
        "numeroPosicao"
    ).innerText =
        (numero + 1) +
        " / " +
        confrontos.length;


    document.getElementById(
        "posicaoAtual"
    ).innerText =
        confronto.posicao;


    /* JOGADOR 1 */

    document.getElementById(
        "jogador1"
    ).value =
        confronto.jogador1.nome;


    document.getElementById(
        "time1"
    ).value =
        confronto.jogador1.time;


    document.getElementById(
        "foto1"
    ).value =
        confronto.jogador1.foto;


    /* JOGADOR 2 */

    document.getElementById(
        "jogador2"
    ).value =
        confronto.jogador2.nome;


    document.getElementById(
        "time2"
    ).value =
        confronto.jogador2.time;


    document.getElementById(
        "foto2"
    ).value =
        confronto.jogador2.foto;


    atualizarBotoes();

    mostrarEscolhaDaPosicao();


    if (enviar) {

        enviarConfrontoAtual();

    }

}


/* =========================================
   PEGAR CAMPOS
========================================= */

function pegarDadosJogadores() {

    return {

        jogador1:
            document.getElementById(
                "jogador1"
            ).value.trim(),

        time1:
            document.getElementById(
                "time1"
            ).value.trim(),

        foto1:
            document.getElementById(
                "foto1"
            ).value.trim(),

        jogador2:
            document.getElementById(
                "jogador2"
            ).value.trim(),

        time2:
            document.getElementById(
                "time2"
            ).value.trim(),

        foto2:
            document.getElementById(
                "foto2"
            ).value.trim()

    };

}


/* =========================================
   ENVIAR CONFRONTO ATUAL AO OVERLAY
========================================= */

function enviarConfrontoAtual() {

    const confronto =
        confrontos[indice];


    const dados =
        pegarDadosJogadores();


    enviarEstado({

        posicao:
            confronto.posicao,

        numeroPosicao:
            indice + 1,

        ...dados,

        vencedor:
            null,

        ladoVencedor:
            null

    });

}


/* =========================================
   ATUALIZAR BOTÕES
========================================= */

function atualizarBotoes() {

    const nome1 =
        document.getElementById(
            "jogador1"
        ).value;


    const nome2 =
        document.getElementById(
            "jogador2"
        ).value;


    document.querySelector(
        ".escolher1"
    ).innerText =
        "ESCOLHER " +
        nome1.toUpperCase();


    document.querySelector(
        ".escolher2"
    ).innerText =
        "ESCOLHER " +
        nome2.toUpperCase();

}


/* =========================================
   MOSTRAR ESCOLHA EXISTENTE
========================================= */

function mostrarEscolhaDaPosicao() {

    const confronto =
        confrontos[indice];


    const escolha =
        timeIdeal.find(
            item =>
                item.posicao ===
                confronto.posicao
        );


    const vencedor =
        document.getElementById(
            "vencedor"
        );


    if (escolha) {

        vencedor.innerText =
            "ESCOLHIDO: " +
            escolha.jogador.toUpperCase() +
            " — " +
            escolha.time.toUpperCase();


        vencedor.classList.add(
            "escolhido"
        );

    }

    else {

        vencedor.innerText =
            "Nenhum jogador escolhido";


        vencedor.classList.remove(
            "escolhido"
        );

    }

}


/* =========================================
   ESCOLHER JOGADOR
========================================= */

function escolherJogador(lado) {

    const confronto =
        confrontos[indice];


    const dados =
        pegarDadosJogadores();


    let jogadorEscolhido;
    let timeEscolhido;
    let fotoEscolhida;


    if (lado === 1) {

        jogadorEscolhido =
            dados.jogador1;

        timeEscolhido =
            dados.time1;

        fotoEscolhida =
            dados.foto1;

    }

    else {

        jogadorEscolhido =
            dados.jogador2;

        timeEscolhido =
            dados.time2;

        fotoEscolhida =
            dados.foto2;

    }


    /*
       VERIFICA SE ESSA POSIÇÃO
       JÁ POSSUÍA UM VENCEDOR
    */

    const existente =
        timeIdeal.find(
            item =>
                item.posicao ===
                confronto.posicao
        );


    /*
       PRIMEIRA ESCOLHA
    */

    if (!existente) {

        if (lado === 1) {

            placar1++;

        }

        else {

            placar2++;

        }

    }


    /*
       TROCA DO VENCEDOR
    */

    else if (
        existente.lado !== lado
    ) {

        if (
            existente.lado === 1
        ) {

            placar1--;
            placar2++;

        }

        else {

            placar2--;
            placar1++;

        }

    }


    /*
       REMOVE A ESCOLHA ANTIGA
       DESSA POSIÇÃO
    */

    timeIdeal =
        timeIdeal.filter(
            item =>
                item.posicao !==
                confronto.posicao
        );


    /*
       SALVA NOVO VENCEDOR
    */

    timeIdeal.push({

        posicao:
            confronto.posicao,

        jogador:
            jogadorEscolhido,

        time:
            timeEscolhido,

        foto:
            fotoEscolhida,

        lado:
            lado,

        indice:
            indice

    });


    /*
       ORDENA PELA POSIÇÃO
    */

    timeIdeal.sort(
        (a, b) =>
            a.indice - b.indice
    );


    /*
       MOSTRA NO PAINEL
    */

    mostrarEscolhaDaPosicao();


    /*
       ENVIA PARA O SERVIDOR
    */

    enviarEstado({

        posicao:
            confronto.posicao,

        numeroPosicao:
            indice + 1,

        ...dados,

        vencedor:
            jogadorEscolhido,

        ladoVencedor:
            lado,

        placar1:
            placar1,

        placar2:
            placar2,

        timeIdeal:
            timeIdeal

    });

}


/* =========================================
   PRÓXIMO
========================================= */

function proximo() {

    if (
        indice <
        confrontos.length - 1
    ) {

        indice++;

        carregarConfronto(
            indice,
            true
        );

    }

}


/* =========================================
   ANTERIOR
========================================= */

function anterior() {

    if (indice > 0) {

        indice--;

        carregarConfronto(
            indice,
            true
        );

    }

}


/* =========================================
   CAMPOS EDITÁVEIS
========================================= */

function campoAlterado() {

    atualizarBotoes();

    /*
       Alteração manual no painel
       também vai para o OBS.
    */

    enviarConfrontoAtual();

}


[
    "jogador1",
    "time1",
    "foto1",
    "jogador2",
    "time2",
    "foto2"

].forEach(id => {

    document
        .getElementById(id)
        .addEventListener(
            "input",
            campoAlterado
        );

});


/* =========================================
   RESETAR
========================================= */

async function resetar11x11() {

    const confirmar =
        confirm(
            "Deseja realmente resetar o 11x11?"
        );


    if (!confirmar) {

        return;

    }


    try {

        const resposta =
            await fetch(
                "/api/reset",
                {
                    method: "POST"
                }
            );


        const resultado =
            await resposta.json();


        if (!resultado.ok) {

            throw new Error(
                "Não foi possível resetar."
            );

        }


        indice = 0;

        placar1 = 0;
        placar2 = 0;

        timeIdeal = [];


        carregarConfronto(
            0,
            true
        );


        statusServidor(
            "11x11 RESETADO",
            "#6cff9d"
        );

    }

    catch (erro) {

        console.error(erro);

        statusServidor(
            "ERRO AO RESETAR",
            "#ff5c5c"
        );

    }

}


/* =========================================
   INICIAR
========================================= */

carregarConfrontos();

</script>

</body>

</html>
