<meta charset="UTF-8">
<title>Bate-Bola da Rodada</title>

<style>
* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #050505;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    display: flex;
    align-items: center;
    justify-content: center;
}

/* CENÁRIO */
.estadio {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;

    background:
        radial-gradient(
            ellipse at center top,
            #35434c 0%,
            #182128 35%,
            #080b0e 75%
        );
}

/* ARQUIBANCADAS */
.arquibancada {
    position: absolute;
    top: 8%;
    left: 5%;
    right: 5%;
    height: 42%;

    border-radius: 50% 50% 15% 15%;

    background:
        repeating-linear-gradient(
            0deg,
            #28343b 0px,
            #28343b 5px,
            #1b252b 6px,
            #1b252b 13px
        );

    box-shadow:
        inset 0 0 80px #000,
        0 20px 80px #000;
}

/* LUZES */
.luzes {
    position: absolute;
    top: 9%;
    left: 10%;
    right: 10%;
    height: 5px;

    background: white;

    box-shadow:
        0 0 15px white,
        0 0 35px rgba(255,255,255,.5);
}

/* GRAMADO */
.gramado {
    position: absolute;

    left: -15%;
    right: -15%;
    bottom: -30%;

    height: 70%;

    transform:
        perspective(600px)
        rotateX(45deg);

    background:
        repeating-linear-gradient(
            90deg,
            #155d2c 0px,
            #155d2c 100px,
            #176b33 101px,
            #176b33 200px
        );

    border: 3px solid rgba(255,255,255,.3);
}

/* LINHA CENTRAL */
.linha {
    position: absolute;

    left: 50%;
    top: 0;
    bottom: 0;

    width: 3px;

    background: rgba(255,255,255,.35);
}

/* CÍRCULO CENTRAL */
.circulo {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 180px;
    height: 180px;

    transform: translate(-50%, -50%);

    border:
        3px solid
        rgba(255,255,255,.35);

    border-radius: 50%;
}

/* ESCURECIMENTO NAS BORDAS */
.vinheta {
    position: absolute;
    inset: 0;

    background:
        radial-gradient(
            circle,
            transparent 30%,
            rgba(0,0,0,.75) 100%
        );
}

/* CONTEÚDO */
.conteudo {
    position: absolute;

    inset: 0;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    text-align: center;

    color: white;
}

/* NOME DO QUADRO */
.titulo {
    font-size: 20px;

    letter-spacing: 6px;

    font-weight: bold;

    opacity: .8;

    text-transform: uppercase;

    margin-bottom: 25px;
}

/* CONFRONTO */
.confronto {
    font-size: 70px;

    font-weight: 900;

    letter-spacing: 3px;

    text-shadow:
        0 5px 25px black;

    animation:
        aparecer 1.2s ease-out;
}

/* X */
.x {
    opacity: .5;

    margin: 0 20px;
}

/* ANIMAÇÃO */
@keyframes aparecer {

    from {
        opacity: 0;
        transform: scale(.8);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

}

</style>
</head>

<body>

<div class="estadio">

    <div class="arquibancada"></div>

    <div class="luzes"></div>

    <div class="gramado">
        <div class="linha"></div>
        <div class="circulo"></div>
    </div>

    <div class="vinheta"></div>

    <div class="conteudo">

        <div class="titulo">
            Bate-Bola da Rodada
        </div>

        <div class="confronto">

            FLAMENGO

            <span class="x">×</span>

            VASCO

        </div>

    </div>

</div>

</body>
</html>
